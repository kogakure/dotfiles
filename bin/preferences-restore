#!/bin/bash
#
# Restore application preferences from private/preferences/.
#
# Usage: preferences-restore [--dry-run] [--yes]
#
# Pass --yes to skip the confirmation prompts (for unattended runs).
#
# The table lives in bin/lib/preferences.manifest. This walks it three times —
# defaults, then plists, then the two support directories — which is the order
# the hand-written version used, and the reason one manifest can drive both
# directions: it is the same ordered list read through a kind filter.
#
# `set -uo pipefail`, deliberately without -e: on a fresh machine most of these
# apps have never launched, and one missing plist must not abort the rest.

set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

dotfiles_flags_init

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DOTFILES_DRY_RUN=1 ;;
        -y | --yes) DOTFILES_ASSUME_YES=1 ;;
        -h | --help)
            log_info "Usage: preferences-restore [--dry-run] [--yes]"
            exit 0
            ;;
        *)
            log_err "preferences-restore: unknown argument: $1"
            exit 1
            ;;
    esac
    shift
done

PREFS=$(prefs_dir)

if [ ! -d "$PREFS" ]; then
    log_err "preferences-restore: ${PREFS} not found — is the private submodule initialised?"
    exit 1
fi

prefs_load "$(prefs_manifest)" || exit 1

# One pass over the rows whose kind matches $1.
restore_pass() {
    local want=$1 i=0
    while [ "$i" -lt ${#PREFS_ROWS[@]} ]; do
        prefs_split "${PREFS_ROWS[$i]}"
        i=$((i + 1))
        case "$PREFS_KIND" in
            "$want") prefs_restore "$PREFS" ;;
        esac
    done
}

log_step "Restoring preference domains..."
restore_pass defaults

log_step "Restoring application plists..."
restore_pass plist

# Both support directories go last, as they did before: they are the two entries
# whose destination the app itself has to create first.
log_step "Restoring application support directories..."
restore_pass support_dir
restore_pass support_contents

if [ "$DOTFILES_DRY_RUN" -eq 1 ]; then
    log_warn "dry run: nothing was changed"
else
    log_done "Done."
fi
