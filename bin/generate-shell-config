#!/bin/bash
#
# generate-shell-config
# Emits the bash/zsh/fish/nushell forms of shell/*.spec into generated/ and, in
# the fish case, into whichever directory FISH_OUT names.
#
# Generated files are committed. Nothing depends on this script at shell-startup
# time, and `bin/dotfiles-lint drift` re-runs it and fails if the tree is stale.
#
# The output must be byte-identical on macOS and on Linux, because CI runs the
# drift gate on both. So guards are emitted as *runtime* conditionals and the
# Homebrew prefix is resolved by the generated file, never by this one.
#
# Usage: generate-shell-config [--dry-run]
#
# $DOTFILES_GENERATE_OUT relocates the whole output tree, which is how
# bin/dotfiles-doctor checks for staleness without writing anything:
#
#   DOTFILES_GENERATE_OUT="$tmp" generate-shell-config && diff -r "$tmp/generated" generated

# SC2016 is disabled for this file, not repo-wide. Emitting the literal text
# `$__dl_os` or `$env.PATH` for another shell to expand later is the entire job
# of a generator, so "expressions don't expand in single quotes" is the intent
# on every one of the fourteen lines it fires on. Silencing them individually
# would be more noise than signal; a .shellcheckrc change would weaken the gate
# for all 51 shell sources instead of this one.
# shellcheck disable=SC2016

set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

dotfiles_flags_init

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DOTFILES_DRY_RUN=1 ;;
        -h | --help)
            log_info "Usage: generate-shell-config [--dry-run]"
            exit 0
            ;;
        *)
            log_err "generate-shell-config: unknown argument: $1"
            exit 1
            ;;
    esac
    shift
done

ROOT=$(dotfiles_root)
cd "$ROOT"

SPEC_DIR=shell

# Where the output goes. $DOTFILES_GENERATE_OUT relocates all of it — every path
# below is relative to it, so the tree it produces mirrors the repository's.
#
# The default is `.`, which makes the normal run byte-identical to what it was
# before this existed, so `just lint drift` is unaffected.
#
# It exists for bin/dotfiles-doctor, which has to answer "are the committed
# generated files current?" without writing. `--dry-run` cannot answer it: it
# prints the paths it would write, not their contents, so there is nothing to
# compare. Generating into a temporary directory and diffing can, and leaves the
# working tree untouched — which is a property doctor asserts about itself.
#
# `just lint drift` still regenerates in place on purpose. It is allowed to
# write, and only regenerating for real proves the committed output matches the
# spec. See docs/guardrails.md.
OUT_ROOT=${DOTFILES_GENERATE_OUT:-.}
OUT_DIR=$OUT_ROOT/generated

# Where the fish files go.
#
# `~/.config/fish` is a *directory symlink* into this repo and fish sources
# conf.d/* before config.fish, so these are live the instant they are written —
# there is no "added but not activated" state. That is why the commit which
# first pointed this at conf.d is the same commit that stripped config.fish
# down to fish-only concerns: with both halves doing the work, every PATH entry
# and every tool hook would have applied twice.
#
# .gitignore names the vendored fisher files individually rather than ignoring
# this directory, so these four stay visible to `git status` and `git checkout`
# can actually undo them.
FISH_OUT=$OUT_ROOT/config/fish/conf.d
NU_OUT=$OUT_ROOT/config/nushell

BANNER_1="GENERATED by bin/generate-shell-config — DO NOT EDIT."
BANNER_2="Edit shell/*.spec and re-run \`just generate\` (or bin/generate-shell-config)."

# --- spec parsing -----------------------------------------------------------

MACRO_NAME=()
MACRO_VAL=()

ENV_GUARD=()
ENV_KIND=()
ENV_NAME=()
ENV_VAL=()

PATH_GUARD=()
PATH_DIR=()

ALIAS_GUARD=()
ALIAS_NAME=()
ALIAS_BODY=()

HOOK_NAME=()
HOOK_GUARD=()
HOOK_BASH=()
HOOK_ZSH=()
HOOK_FISH=()

# Strip full-line comments, blank lines, and surrounding whitespace. A `#` in
# the middle of a value is data, not a comment, so only leading `#` counts.
spec_lines() {
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" |
        grep -v '^#' | grep -v '^$'
}

# Split "@guard rest" into its two halves. A line with no leading @ is all rest.
guard_of() {
    case $1 in
        @*) printf '%s' "${1%% *}" ;;
        *) printf '' ;;
    esac
}

rest_of() {
    case $1 in
        @*) printf '%s' "${1#* }" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Expand %MACRO references. Definition order is expansion order, so a macro may
# refer to one defined above it.
expand_macros() {
    local val=$1 i
    for ((i = 0; i < ${#MACRO_NAME[@]}; i++)); do
        val=${val//%${MACRO_NAME[$i]}/${MACRO_VAL[$i]}}
    done
    printf '%s' "$val"
}

die_guard() {
    log_err "generate-shell-config: unknown guard '$1' in $2"
    exit 1
}

parse_env() {
    local line guard rest name val kind expanded
    while IFS= read -r line; do
        guard=$(guard_of "$line")
        rest=$(rest_of "$line")
        name=${rest%%=*}
        val=${rest#*=}
        name=${name%"${name##*[![:space:]]}"}
        val=${val#"${val%%[![:space:]]*}"}
        case $name in
            %*)
                # Expand *before* appending the name: expand_macros loops to
                # ${#MACRO_NAME[@]}, so a half-appended pair would index a
                # MACRO_VAL that is one short — an unbound variable under
                # `set -u` on bash 3.2.
                expanded=$(expand_macros "$val")
                MACRO_NAME[${#MACRO_NAME[@]}]=${name#%}
                MACRO_VAL[${#MACRO_VAL[@]}]=$expanded
                continue
                ;;
            +*)
                kind=list
                name=${name#+}
                ;;
            *) kind=var ;;
        esac
        ENV_GUARD[${#ENV_GUARD[@]}]=$guard
        ENV_KIND[${#ENV_KIND[@]}]=$kind
        ENV_NAME[${#ENV_NAME[@]}]=$name
        ENV_VAL[${#ENV_VAL[@]}]=$(expand_macros "$val")
    done < <(spec_lines "$SPEC_DIR/env.spec")
}

parse_path() {
    local line
    while IFS= read -r line; do
        PATH_GUARD[${#PATH_GUARD[@]}]=$(guard_of "$line")
        PATH_DIR[${#PATH_DIR[@]}]=$(rest_of "$line")
    done < <(spec_lines "$SPEC_DIR/path.spec")
}

parse_aliases() {
    local line guard rest name val
    while IFS= read -r line; do
        guard=$(guard_of "$line")
        rest=$(rest_of "$line")
        name=${rest%%=*}
        val=${rest#*=}
        name=${name%"${name##*[![:space:]]}"}
        val=${val#"${val%%[![:space:]]*}"}
        ALIAS_GUARD[${#ALIAS_GUARD[@]}]=$guard
        ALIAS_NAME[${#ALIAS_NAME[@]}]=$name
        ALIAS_BODY[${#ALIAS_BODY[@]}]=$(expand_macros "$val")
    done < <(spec_lines "$SPEC_DIR/aliases.spec")
}

parse_hooks() {
    local line key val i
    while IFS= read -r line; do
        key=${line%% *}
        val=${line#* }
        case $key in
            tool)
                HOOK_NAME[${#HOOK_NAME[@]}]=$val
                HOOK_GUARD[${#HOOK_GUARD[@]}]=""
                HOOK_BASH[${#HOOK_BASH[@]}]=""
                HOOK_ZSH[${#HOOK_ZSH[@]}]=""
                HOOK_FISH[${#HOOK_FISH[@]}]=""
                ;;
            guard | bash | zsh | fish)
                i=$((${#HOOK_NAME[@]} - 1))
                if [ "$i" -lt 0 ]; then
                    log_err "generate-shell-config: '$key' before any 'tool' in hooks.spec"
                    exit 1
                fi
                case $key in
                    guard) HOOK_GUARD[i]=$val ;;
                    bash) HOOK_BASH[i]=$val ;;
                    zsh) HOOK_ZSH[i]=$val ;;
                    fish) HOOK_FISH[i]=$val ;;
                esac
                ;;
            *)
                log_err "generate-shell-config: unknown key '$key' in hooks.spec"
                exit 1
                ;;
        esac
    done < <(spec_lines "$SPEC_DIR/hooks.spec")
}

# --- dialect translation ----------------------------------------------------

guard_posix() {
    case $1 in
        "") printf '' ;;
        @darwin) printf '[ "$__dl_os" = Darwin ]' ;;
        @linux) printf '[ "$__dl_os" = Linux ]' ;;
        @brew) printf '[ -n "$__dl_brew_prefix" ]' ;;
        @interactive) printf '[ "$__dl_interactive" -eq 1 ]' ;;
        @cmd:*) printf 'command -v %s >/dev/null 2>&1' "${1#@cmd:}" ;;
        @dir:*) printf '[ -d "%s" ]' "${1#@dir:}" ;;
        *) die_guard "$1" "a POSIX target" ;;
    esac
}

guard_fish() {
    case $1 in
        "") printf '' ;;
        @darwin) printf 'test "$__dl_os" = Darwin' ;;
        @linux) printf 'test "$__dl_os" = Linux' ;;
        @brew) printf 'test -n "$__dl_brew_prefix"' ;;
        @interactive) printf 'status is-interactive' ;;
        @cmd:*) printf 'command -v %s >/dev/null 2>&1' "${1#@cmd:}" ;;
        @dir:*) printf 'test -d "%s"' "${1#@dir:}" ;;
        *) die_guard "$1" "a fish target" ;;
    esac
}

val_posix() {
    local v=$1
    v=${v//\$BREW_PREFIX/\$\{__dl_brew_prefix\}}
    printf '%s' "$v"
}

val_fish() {
    local v=$1
    v=${v//\$BREW_PREFIX/\$__dl_brew_prefix}
    printf '%s' "$v"
}

# Nushell has no $HOME interpolation outside an interpolated string, so values
# become $"..." with ($env.HOME) substituted in.
val_nu() {
    local v=$1
    # The replacement halves are escaped: an unescaped `($__dl_brew_prefix)`
    # would be expanded by *this* shell instead of emitted for nushell.
    v=${v//\$BREW_PREFIX/(\$__dl_brew_prefix)}
    v=${v//\$HOME/(\$env.HOME)}
    printf '%s' "$v"
}

# Escape for a single-quoted shell string: ' becomes '\''.
sq() {
    local s=$1
    s=${s//\'/\'\\\'\'}
    printf '%s' "$s"
}

# Escape for a double-quoted shell string.
dq() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '%s' "$s"
}

posix_banner() {
    printf '# %s\n# %s\n#\n# Source: %s\n' "$BANNER_1" "$BANNER_2" "$1"
}

# --- the runtime preludes ---------------------------------------------------
#
# Emitted rather than resolved, so one committed file works on every host and
# on both CI runners.

posix_prelude() {
    cat <<'PRELUDE'
__dl_os=$(uname)

case $- in
    *i*) __dl_interactive=1 ;;
    *) __dl_interactive=0 ;;
esac

if [ -x /opt/homebrew/bin/brew ]; then
    __dl_brew_prefix=/opt/homebrew
elif [ -x /usr/local/bin/brew ]; then
    __dl_brew_prefix=/usr/local
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    __dl_brew_prefix=/home/linuxbrew/.linuxbrew
else
    __dl_brew_prefix=
fi

# HOMEBREW_PREFIX/CELLAR/REPOSITORY, INFOPATH, the zsh site-functions fpath
# entry and path_helper. PATH is rebuilt from shell/path.spec below, so
# whatever this prepends is normalised away.
if [ -n "$__dl_brew_prefix" ]; then
    eval "$("$__dl_brew_prefix/bin/brew" shellenv)"
fi
PRELUDE
}

fish_prelude() {
    cat <<'PRELUDE'
set -g __dl_os (uname)

if test -x /opt/homebrew/bin/brew
    set -g __dl_brew_prefix /opt/homebrew
else if test -x /usr/local/bin/brew
    set -g __dl_brew_prefix /usr/local
else if test -x /home/linuxbrew/.linuxbrew/bin/brew
    set -g __dl_brew_prefix /home/linuxbrew/.linuxbrew
else
    set -g __dl_brew_prefix ""
end

if test -n "$__dl_brew_prefix"
    $__dl_brew_prefix/bin/brew shellenv fish | source
end
PRELUDE
}

# --- emitters ---------------------------------------------------------------

emit_posix_env() {
    local i guard cond name val kind
    posix_banner "shell/env.spec, shell/path.spec"
    cat <<'HEAD'

# Sourced by ~/.profile and ~/.zshenv, so it reaches non-interactive shells
# too. It must not prompt, must not depend on a terminal, and must not print.

# Only source this once.
if [ -n "${SESSION_VARS_SOURCED:-}" ]; then return; fi
SESSION_VARS_SOURCED=1
export SESSION_VARS_SOURCED

HEAD
    posix_prelude
    printf '\n# --- environment (shell/env.spec) ---\n\n'
    local prev="__none__"
    for ((i = 0; i < ${#ENV_NAME[@]}; i++)); do
        guard=${ENV_GUARD[$i]}
        name=${ENV_NAME[$i]}
        kind=${ENV_KIND[$i]}
        val=$(val_posix "${ENV_VAL[$i]}")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
            cond=$(guard_posix "$guard")
            [ -z "$cond" ] || printf 'if %s; then\n' "$cond"
            prev=$guard
        fi
        if [ -n "$guard" ]; then
            posix_env_line "$kind" "$name" "$val" "    "
        else
            posix_env_line "$kind" "$name" "$val" ""
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
    emit_posix_path
}

posix_env_line() {
    local kind=$1 name=$2 val=$3 pad=$4
    if [ "$kind" = list ]; then
        # Prepend only if absent, so re-sourcing is a no-op. A plain prepend
        # grows the list on every nested shell — the same defect this phase
        # removes from PATH.
        printf '%scase ":${%s:-}:" in\n' "$pad" "$name"
        printf '%s    *":%s:"*) ;;\n' "$pad" "$(dq "$val")"
        printf '%s    *) %s="%s${%s:+:${%s}}" ;;\n' "$pad" "$name" "$(dq "$val")" "$name" "$name"
        printf '%sesac\n' "$pad"
        printf '%sexport %s\n' "$pad" "$name"
        return
    fi
    # A command substitution has to be assigned before it is exported, or
    # SC2155 fires — which is exactly the finding the old
    # session-variables.sh:70 carried. (Spelled without the linter's own
    # directive prefix on purpose: that would be read as a directive.)
    case $val in
        *'$('*)
            printf '%s%s="%s"\n' "$pad" "$name" "$(dq "$val")"
            printf '%sexport %s\n' "$pad" "$name"
            ;;
        *) printf '%sexport %s="%s"\n' "$pad" "$name" "$(dq "$val")" ;;
    esac
}

emit_posix_path() {
    local i guard cond dir
    cat <<'HEAD'

# --- PATH (shell/path.spec) ---
#
# Add each spec entry if it exists and is not already present, then keep
# whatever PATH was inherited. Re-running this is a no-op, which is the point:
# the old `set -x PATH $PATH ...` in config.fish appended unconditionally, so a
# fish shell inside a fish shell carried 15 duplicated entries.

__dl_path=

__dl_add() {
    [ -d "$1" ] || return 0
    case ":$__dl_path:" in
        *":$1:"*) return 0 ;;
    esac
    __dl_path="${__dl_path:+$__dl_path:}$1"
}

HEAD
    local prev="__none__"
    for ((i = 0; i < ${#PATH_DIR[@]}; i++)); do
        guard=${PATH_GUARD[$i]}
        dir=$(val_posix "${PATH_DIR[$i]}")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
            cond=$(guard_posix "$guard")
            [ -z "$cond" ] || printf 'if %s; then\n' "$cond"
            prev=$guard
        fi
        if [ -n "$guard" ]; then
            printf '    __dl_add "%s"\n' "$(dq "$dir")"
        else
            printf '__dl_add "%s"\n' "$(dq "$dir")"
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
    cat <<'TAIL'

# Inherited entries keep their relative order and are not existence-filtered:
# dropping a directory another process put there is not this file's business.
__dl_rest=$PATH
while [ -n "$__dl_rest" ]; do
    __dl_entry=${__dl_rest%%:*}
    case $__dl_rest in
        *:*) __dl_rest=${__dl_rest#*:} ;;
        *) __dl_rest= ;;
    esac
    if [ -n "$__dl_entry" ]; then
        case ":$__dl_path:" in
            *":$__dl_entry:"*) ;;
            *) __dl_path="${__dl_path:+$__dl_path:}$__dl_entry" ;;
        esac
    fi
done

PATH=$__dl_path
export PATH

unset __dl_path __dl_rest __dl_entry __dl_os __dl_interactive __dl_brew_prefix
unset -f __dl_add
TAIL
}

emit_posix_aliases() {
    local i guard cond name body
    posix_banner "shell/aliases.spec"
    cat <<'HEAD'

# `reload` is defined per shell in bashrc/zshrc: it is genuinely
# shell-specific, unlike everything below.

HEAD
    printf '__dl_os=$(uname)\n\n'
    local prev="__none__"
    for ((i = 0; i < ${#ALIAS_NAME[@]}; i++)); do
        guard=${ALIAS_GUARD[$i]}
        name=${ALIAS_NAME[$i]}
        body=$(sq "$(val_posix "${ALIAS_BODY[$i]}")")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
            cond=$(guard_posix "$guard")
            [ -z "$cond" ] || printf 'if %s; then\n' "$cond"
            prev=$guard
        fi
        if [ -n "$guard" ]; then
            printf '    alias %s='"'"'%s'"'"'\n' "$name" "$body"
        else
            printf 'alias %s='"'"'%s'"'"'\n' "$name" "$body"
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'fi\n'
    cat <<'TAIL'

unset __dl_os

# Identity-bearing aliases live in the private submodule, not in this public
# repo. See docs/architecture.md.
if [ -r "$HOME/.dotfiles/private/shell/aliases-private.sh" ]; then
    # shellcheck source=/dev/null  # private submodule, not resolvable in CI
    . "$HOME/.dotfiles/private/shell/aliases-private.sh"
fi
TAIL
}

emit_posix_hooks() {
    local dialect=$1 i cond body
    posix_banner "shell/hooks.spec"
    printf '\n# Sourced from %src. Interactive shells only.\n\n' "$dialect"
    printf 'if [[ $- == *i* ]]; then\n'
    for ((i = 0; i < ${#HOOK_NAME[@]}; i++)); do
        case $dialect in
            bash) body=${HOOK_BASH[$i]} ;;
            zsh) body=${HOOK_ZSH[$i]} ;;
            *) body="" ;;
        esac
        [ -n "$body" ] || continue
        cond=$(guard_posix "${HOOK_GUARD[$i]}")
        printf '    # %s\n' "${HOOK_NAME[$i]}"
        if [ -n "$cond" ]; then
            printf '    if %s; then\n        %s\n    fi\n' "$cond" "$body"
        else
            printf '    %s\n' "$body"
        fi
    done
    printf 'fi\n'
}

emit_fish_env() {
    local i guard cond name val kind
    posix_banner "shell/env.spec"
    printf '\n'
    fish_prelude
    printf '\n# --- environment (shell/env.spec) ---\n\n'
    local prev="__none__"
    for ((i = 0; i < ${#ENV_NAME[@]}; i++)); do
        guard=${ENV_GUARD[$i]}
        name=${ENV_NAME[$i]}
        kind=${ENV_KIND[$i]}
        val=$(val_fish "${ENV_VAL[$i]}")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
            cond=$(guard_fish "$guard")
            [ -z "$cond" ] || printf 'if %s\n' "$cond"
            prev=$guard
        fi
        local pad=""
        [ -z "$guard" ] || pad="    "
        if [ "$kind" = list ]; then
            # MANPATH is one of fish's colon-split path variables, so a list
            # assignment is the native form. Guarded by `contains` so that
            # re-sourcing does not grow the list.
            printf '%sif not contains -- %s $%s\n' "$pad" "$val" "$name"
            printf '%s    set -gx %s %s $%s\n' "$pad" "$name" "$val" "$name"
            printf '%send\n' "$pad"
        else
            printf '%sset -gx %s "%s"\n' "$pad" "$name" "$(dq "$val")"
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
}

emit_fish_path() {
    local i guard cond dir
    posix_banner "shell/path.spec"
    cat <<'HEAD'

# Built once from an ordered list rather than accumulated with
# `set -x PATH $PATH ...`, which appended unconditionally and left 15
# duplicated entries in a nested fish shell.
#
# fish_add_path is deliberately not used: without --path it writes
# $fish_user_paths, a *universal* variable that persists across sessions and
# survives every change to this file.

set -l __dl_want

HEAD
    local prev="__none__"
    for ((i = 0; i < ${#PATH_DIR[@]}; i++)); do
        guard=${PATH_GUARD[$i]}
        dir=$(val_fish "${PATH_DIR[$i]}")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
            cond=$(guard_fish "$guard")
            [ -z "$cond" ] || printf 'if %s\n' "$cond"
            prev=$guard
        fi
        if [ -n "$guard" ]; then
            printf '    set -a __dl_want %s\n' "$dir"
        else
            printf 'set -a __dl_want %s\n' "$dir"
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
    cat <<'TAIL'

set -l __dl_new
for __dl_p in $__dl_want
    if test -d $__dl_p; and not contains -- $__dl_p $__dl_new
        set -a __dl_new $__dl_p
    end
end

# Inherited entries keep their order and are not existence-filtered.
for __dl_p in $PATH
    if not contains -- $__dl_p $__dl_new
        set -a __dl_new $__dl_p
    end
end

set -gx PATH $__dl_new
TAIL
}

emit_fish_aliases() {
    local i guard cond name body
    posix_banner "shell/aliases.spec"
    printf '\n'
    local prev="__none__"
    for ((i = 0; i < ${#ALIAS_NAME[@]}; i++)); do
        guard=${ALIAS_GUARD[$i]}
        name=${ALIAS_NAME[$i]}
        body=$(sq "$(val_fish "${ALIAS_BODY[$i]}")")
        if [ "$guard" != "$prev" ]; then
            [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
            cond=$(guard_fish "$guard")
            [ -z "$cond" ] || printf 'if %s\n' "$cond"
            prev=$guard
        fi
        if [ -n "$guard" ]; then
            printf '    alias %s '"'"'%s'"'"'\n' "$name" "$body"
        else
            printf 'alias %s '"'"'%s'"'"'\n' "$name" "$body"
        fi
    done
    [ "$prev" = "__none__" ] || [ -z "$prev" ] || printf 'end\n'
    cat <<'TAIL'

# Identity-bearing aliases live in the private submodule, not in this public
# repo. See docs/architecture.md.
if test -r "$HOME/.dotfiles/private/shell/aliases-private.fish"
    source "$HOME/.dotfiles/private/shell/aliases-private.fish"
end
TAIL
}

emit_fish_hooks() {
    local i cond body
    posix_banner "shell/hooks.spec"
    printf '\n'
    printf 'if status is-interactive\n'
    for ((i = 0; i < ${#HOOK_NAME[@]}; i++)); do
        body=${HOOK_FISH[$i]}
        [ -n "$body" ] || continue
        cond=$(guard_fish "${HOOK_GUARD[$i]}")
        printf '    # %s\n' "${HOOK_NAME[$i]}"
        if [ -n "$cond" ]; then
            printf '    if %s\n        %s\n    end\n' "$cond" "$body"
        else
            printf '    %s\n' "$body"
        fi
    done
    cat <<'TAIL'
end

# Set by conf.d/00-env.fish and read by the generated conf.d files. config.fish
# sources this one last of all, so they are cleaned up here.
set -e __dl_os
set -e __dl_brew_prefix
TAIL
}

emit_nu_env() {
    local i dir val
    printf '# %s\n# %s\n#\n# Source: shell/env.spec, shell/path.spec\n' "$BANNER_1" "$BANNER_2"
    cat <<'HEAD'
#
# Nushell gets PATH and the unguarded environment from the same spec as the
# other three shells. Guarded entries are skipped rather than translated: the
# `path exists` filter below already handles the platform-specific PATH
# entries, and nushell cannot conditionally assign $env from inside a block.

let __dl_brew_prefix = (
    if ("/opt/homebrew/bin/brew" | path exists) { "/opt/homebrew" }
    else if ("/usr/local/bin/brew" | path exists) { "/usr/local" }
    else if ("/home/linuxbrew/.linuxbrew/bin/brew" | path exists) { "/home/linuxbrew/.linuxbrew" }
    else { "" }
)

HEAD
    for ((i = 0; i < ${#ENV_NAME[@]}; i++)); do
        [ -z "${ENV_GUARD[$i]}" ] || continue
        [ "${ENV_KIND[$i]}" = var ] || continue
        val=${ENV_VAL[$i]}
        case $val in
            *'$('*) continue ;;
        esac
        printf '$env.%s = $"%s"\n' "${ENV_NAME[$i]}" "$(val_nu "$val")"
    done
    printf '\n$env.PATH = ([\n'
    for ((i = 0; i < ${#PATH_DIR[@]}; i++)); do
        dir=$(val_nu "${PATH_DIR[$i]}")
        printf '    $"%s"\n' "$dir"
    done
    cat <<'TAIL'
] | where { |p| $p | path exists } | append $env.PATH | uniq)
TAIL
}

# --- run --------------------------------------------------------------------

parse_env
parse_path
parse_aliases
parse_hooks

run mkdir -p "$OUT_DIR" "$FISH_OUT" "$NU_OUT"

log_step "Generating shell configuration from $SPEC_DIR/*.spec..."

emit_posix_env | write_file "$OUT_DIR/session-variables.sh"
emit_posix_aliases | write_file "$OUT_DIR/aliases.sh"
emit_posix_hooks bash | write_file "$OUT_DIR/hooks.bash"
emit_posix_hooks zsh | write_file "$OUT_DIR/hooks.zsh"
emit_fish_env | write_file "$FISH_OUT/00-env.fish"
emit_fish_path | write_file "$FISH_OUT/10-path.fish"
emit_fish_aliases | write_file "$FISH_OUT/20-aliases.fish"
# Not conf.d. fish loads conf.d/* *before* config.fish, and two vendored fisher
# plugins in there fight with these hooks: conf.d/z.fish defines its own `z`,
# which would shadow zoxide's. The hooks lived at the bottom of config.fish
# before this refactor and have to keep running last, so config.fish sources
# this file at its end via the ~/.hooks.fish link.
emit_fish_hooks | write_file "$OUT_DIR/hooks.fish"
emit_nu_env | write_file "$NU_OUT/env.nu"

log_field "env" "${#ENV_NAME[@]} variable(s)"
log_field "path" "${#PATH_DIR[@]} entry(ies)"
log_field "aliases" "${#ALIAS_NAME[@]}"
log_field "hooks" "${#HOOK_NAME[@]} tool(s)"
log_ok "Generated 9 file(s)."
