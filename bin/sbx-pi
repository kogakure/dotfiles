#!/bin/bash

# sbx-pi
# Runs the Pi coding agent (https://github.com/badlogic/pi-mono) inside a
# Docker Sandboxes (sbx) container, using the custom "pi" sandbox kit at
# config/sbx/kits/pi (see that directory's README.md). Docker Sandboxes has
# no built-in "pi" agent, so this kit teaches it one.
#
# On first launch for a given name, seeds the sandbox with the host's pi
# config (~/.pi/agent, symlinked from this repo's pi/agent): OAuth auth,
# settings, extensions, skills, themes. Subsequent launches just re-attach.
#
# The final `sbx run` is exec'd with argv0 renamed to "pi" (same trick as
# config/fish/functions/sbxa.fish uses for built-in sbx agents), so herdr
# detects the pane as a pi agent instead of seeing a bare `sbx` process.
# This is also what makes sbx-pi work as an `sbxa pi` tier-1 launcher.
#
# Usage: sbx-pi [PATH...] [--name NAME] [sbx create flags] [-- PI_ARGS...]
#   PATH...     Extra workspaces to mount (append ":ro" for read-only),
#               passed through to `sbx create`. Defaults to the current
#               directory. ~/Downloads:ro is always added.
#   --name      Sandbox name (default: pi-<basename of $PWD>).
#   sbx create  --template/-t, --profile, --publish/-p, --memory/-m, --cpus,
#   flags       --clone are forwarded to `sbx create` (only used when the
#               sandbox doesn't already exist).
#   -- ARGS     Arguments forwarded to `pi` itself.

# Bare `set -e`, deliberately not -euo pipefail: this script expands
# possibly-empty arrays, and bash 3.2 — the /bin/bash macOS ships — treats
# an empty array as unbound under `set -u`, which is fatal on the default
# invocation. See docs/guardrails.md.
set -e

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KIT_DIR="$DOTFILES_DIR/config/sbx/kits/pi"
PI_HOST_DIR="$HOME/.pi/agent"

if ! command -v sbx >/dev/null 2>&1; then
    log_err "sbx-pi: 'sbx' (Docker Sandboxes CLI) not found on PATH."
    exit 1
fi

if [ ! -f "$PI_HOST_DIR/auth.json" ]; then
    log_err "sbx-pi: $PI_HOST_DIR/auth.json not found."
    log_err "Log in to pi on the host first (run 'pi' and complete auth) before sandboxing it."
    exit 1
fi

NAME="pi-$(basename "$PWD")"
WORKSPACES=()
CREATE_FLAGS=()
PI_ARGS=()
PARSING_PI_ARGS=false

while [ $# -gt 0 ]; do
    if [ "$PARSING_PI_ARGS" = true ]; then
        PI_ARGS+=("$1")
        shift
        continue
    fi
    case "$1" in
        --name)
            NAME="$2"
            shift 2
            ;;
        # sbx create flags that take a value: forward flag + value untouched.
        --template | -t | --profile | --publish | -p | --memory | -m | --cpus)
            CREATE_FLAGS+=("$1" "$2")
            shift 2
            ;;
        # sbx create flags that take no value.
        --clone)
            CREATE_FLAGS+=("$1")
            shift
            ;;
        --)
            PARSING_PI_ARGS=true
            shift
            ;;
        -h | --help)
            grep '^#' "$0" | tail -n +2 | cut -c3-
            exit 0
            ;;
        *)
            WORKSPACES+=("$1")
            shift
            ;;
    esac
done

run_pi() {
    if [ ${#PI_ARGS[@]} -gt 0 ]; then
        exec -a pi sbx run --name "$NAME" -- "${PI_ARGS[@]}"
    else
        exec -a pi sbx run --name "$NAME"
    fi
}

if sbx ls 2>/dev/null | grep -q "^$NAME"; then
    log_note "sbx-pi: re-attaching to existing sandbox '$NAME'."
    run_pi
fi

if [ ${#WORKSPACES[@]} -eq 0 ]; then
    WORKSPACES=(".")
fi

# ~/Downloads is where screenshots and downloaded assets land, so the agent
# almost always wants to read from it. Read-only: the agent should never be
# able to delete or overwrite anything there. Skipped when the caller already
# named the directory, so an explicit path can override the mode.
downloads_mounted=false
for ws in "${WORKSPACES[@]}"; do
    case "$ws" in
        "$HOME/Downloads" | "$HOME/Downloads:"* | ~/Downloads | ~/Downloads:*)
            downloads_mounted=true
            ;;
    esac
done
if [ "$downloads_mounted" = false ]; then
    WORKSPACES+=("$HOME/Downloads:ro")
fi

log_note "sbx-pi: creating sandbox '$NAME' from kit $KIT_DIR"
sbx create pi --kit "$KIT_DIR" --name "$NAME" "${CREATE_FLAGS[@]}" "${WORKSPACES[@]}"

log_note "sbx-pi: seeding pi config from $PI_HOST_DIR"
sbx exec "$NAME" -- mkdir -p /home/agent/.pi/agent

sbx cp "$PI_HOST_DIR/auth.json" "$NAME:/home/agent/.pi/agent/"

for item in settings.json AGENTS.md extensions skills themes; do
    if [ -e "$PI_HOST_DIR/$item" ]; then
        sbx cp "$PI_HOST_DIR/$item" "$NAME:/home/agent/.pi/agent/"
    else
        log_warn "sbx-pi: skipping $item (not present on host)."
    fi
done

# sbx cp preserves host ownership/permissions; auth.json (mode 600) lands
# owned by the host UID, which the sandbox's uid-1000 "agent" user can't
# read. Reclaim it as root.
sbx exec -u root "$NAME" -- chown -R agent:agent /home/agent/.pi

log_note "sbx-pi: attaching to '$NAME'."
run_pi
