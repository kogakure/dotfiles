#!/bin/bash
#
# codex-backup
# Backs up durable Codex configuration to the private/ submodule.
# Runtime state, credentials, bundled skills, and caches are intentionally excluded.
#
# Usage: codex-backup
# Reads ~/.agentic-profile, falling back to legacy ~/.machine-profile.
# Set with: agentic-set-profile work|personal

set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

dotfiles_flags_init

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DOTFILES_DRY_RUN=1 ;;
        -y | --yes) DOTFILES_ASSUME_YES=1 ;;
        --allow-dirty) DOTFILES_ALLOW_DIRTY=1 ;;
        -h | --help)
            log_info "Usage: codex-backup [--dry-run] [--yes] [--allow-dirty]"
            exit 0
            ;;
        *)
            log_err "codex-backup: unknown argument: $1"
            exit 1
            ;;
    esac
    shift
done

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
DOTFILES=$(dotfiles_root)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

PROFILE=$(agentic_profile) || exit 1
PROFILE_DIR="$DOTFILES/private/codex/$PROFILE"

log_done "Starting Codex configuration backup..."
log_field "Profile" "$PROFILE"
log_field "Codex home" "$CODEX_DIR"

run mkdir -p "$PROFILE_DIR"

log_step "Backing up settings and global instructions..."
backup_file "$CODEX_DIR/config.toml" "$PROFILE_DIR/config.toml"
if [ -f "$PROFILE_DIR/config.toml" ] && ! grep -Eq '^[[:space:]]*personality[[:space:]]*=' "$PROFILE_DIR/config.toml"; then
    if [ "$DOTFILES_DRY_RUN" -eq 1 ]; then
        log_info "  would prepend the default personality to config.toml"
    else
        {
            echo 'personality = "friendly"'
            cat "$PROFILE_DIR/config.toml"
        } >"$PROFILE_DIR/config.toml.tmp"
        mv "$PROFILE_DIR/config.toml.tmp" "$PROFILE_DIR/config.toml"
        log_ok "Recorded current default personality: friendly"
    fi
fi
backup_file "$CODEX_DIR/AGENTS.md" "$PROFILE_DIR/AGENTS.md"
backup_file "$CODEX_DIR/AGENTS.override.md" "$PROFILE_DIR/AGENTS.override.md"
backup_file "$CODEX_DIR/hooks.json" "$PROFILE_DIR/hooks.json"
backup_dir "$CODEX_DIR/rules" "$PROFILE_DIR/rules"

log_step "Backing up user-installed skills..."
# Not backup_dir: this one excludes the bundled .system/ skills, which is the
# whole reason it is written out by hand.
#
# The `else` branch used to `rm -rf "$PROFILE_DIR/skills"`. That is the last of
# codex-backup's prunes, and it is the dangerous one: a machine with no
# ~/.codex/skills at all would delete the skills another machine had committed
# under the same profile. Absent locally now means "leave the backup alone",
# matching every other helper in bin/lib/sync.sh. Removing a skill from the
# backup is a --prune job, once that is wired.
if [ -d "$CODEX_DIR/skills" ]; then
    run mkdir -p "$PROFILE_DIR/skills"
    run rsync -a --delete --exclude='.system/' "$CODEX_DIR/skills/" "$PROFILE_DIR/skills/"
    [ "$DOTFILES_DRY_RUN" -eq 1 ] || log_ok "Backed up: skills/ (bundled .system/ excluded)"
else
    log_skip "Not found: skills/ (the backup is left as it is)"
fi

log_step "Creating backup manifest..."
write_file "$PROFILE_DIR/BACKUP_INFO.txt" <<EOF
Codex Configuration Backup
==========================
Timestamp:  $TIMESTAMP
Hostname:   $(host_id)
Profile:    $PROFILE
Codex Home: $CODEX_DIR

Backed up:
- config.toml (model, personality, UI, MCP servers, plugins, permissions)
- AGENTS.md and AGENTS.override.md (global instructions)
- hooks.json and rules/
- User-installed skills (bundled .system/ skills excluded)

Excluded (credentials, generated, large, or machine-local state):
- auth.json, installation_id
- .codex-global-state.json, .personality_migration
- history.jsonl, sessions/, archived_sessions/, session_index.jsonl
- *.sqlite, *.sqlite-shm, *.sqlite-wal, sqlite/
- plugins/, vendor_imports/, cache/, .tmp/, models_cache.json
- logs, shell snapshots, computer-use/

After restoring, sign in to Codex and restart the app or CLI.
EOF

log_done "Backup complete!"
log_info "  Profile dir: $PROFILE_DIR"
log_info ""
log_info "To restore on another machine, run: codex-restore"
