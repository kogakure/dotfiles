#!/bin/bash
#
# Apply macOS system preferences.
#
# Run with --dry-run to print every mutation instead of applying it. That is the
# only safe way to review this file: `defaults write` has no undo, and a plain
# run applies ~80 of them.

set -euo pipefail

DRY_RUN=0

usage() {
    cat <<'EOF'
Usage: macos-settings [--dry-run]

  --dry-run   Print each mutation instead of applying it.
  -h, --help  Show this help.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "macos-settings: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# Every mutation below goes through this, so --dry-run cannot miss one.
run() {
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '  %s\n' "$*"
    else
        "$@"
    fi
}

section() {
    printf '\n== %s\n' "$1"
}

if [ "$DRY_RUN" -eq 1 ]; then
    echo "macos-settings: dry run, nothing will be changed."
else
    # Close any open System Settings panes, so they cannot overwrite what we are
    # about to change.
    osascript -e 'tell application "System Settings" to quit' 2>/dev/null ||
        osascript -e 'tell application "System Preferences" to quit' 2>/dev/null ||
        true
fi

# Only one mutation in this entire file needs root — `chflags nohidden /Volumes`
# — so it asks for itself, rather than this script taking a blanket grant it
# does not need.

section "Appearance"

run defaults write NSGlobalDomain AppleInterfaceStyle -string Dark

# Sidebar icon size
run defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 3

# Expand save panel by default
run defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
run defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Expand print panel by default
run defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
run defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# Reduce Motion
run defaults write com.apple.Accessibility ReduceMotionEnabled -int 1

# Disable the "Are you sure you want to open this application?" dialog
run defaults write com.apple.LaunchServices LSQuarantine -bool false

section "Text input and keyboard"

# All of these are annoying when typing code.
run defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
run defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

# A blazingly fast keyboard repeat rate
run defaults write NSGlobalDomain KeyRepeat -int 2
run defaults write NSGlobalDomain InitialKeyRepeat -int 15

# Full keyboard access for all controls (e.g. Tab in modal dialogs)
run defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

section "Language and region"

run defaults write NSGlobalDomain AppleLanguages -array "en-DE" "de-DE" "ja-DE"
run defaults write NSGlobalDomain AppleLocale -string "en_DE@currency=EUR"
run defaults write NSGlobalDomain AppleMeasurementUnits -string "Centimeters"

section "Screenshots"

# Only point screencapture at Dropbox if Dropbox is actually there. On a fresh
# machine setup.sh runs this long before Dropbox has synced, and screencapture
# silently keeps writing to the Desktop with no hint why.
SCREENSHOT_DIR="${HOME}/Dropbox/Bilder/Screenshots"
if [ -d "$SCREENSHOT_DIR" ]; then
    run defaults write com.apple.screencapture location -string "$SCREENSHOT_DIR"
else
    echo "  skip: ${SCREENSHOT_DIR} does not exist yet — leaving the screenshot" >&2
    echo "        location alone. Re-run this script once Dropbox has synced." >&2
fi

section "Finder"

# Set Downloads as the default location for new Finder windows.
# For other paths, use `PfLo` and `file:///full/path/here/`.
run defaults write com.apple.finder NewWindowTarget -string "PfLo"
run defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/Downloads/"

# Show/hide icons for hard drives, servers and removable media on the desktop
run defaults write com.apple.finder ShowExternalHardDrivesOnDesktop -bool false
run defaults write com.apple.finder ShowHardDrivesOnDesktop -bool false
run defaults write com.apple.finder ShowMountedServersOnDesktop -bool false
run defaults write com.apple.finder ShowRemovableMediaOnDesktop -bool true

# Show all filename extensions
run defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Show status bar and path bar
run defaults write com.apple.finder ShowStatusBar -bool true
run defaults write com.apple.finder ShowPathbar -bool true

# Keep folders on top when sorting by name
run defaults write com.apple.finder _FXSortFoldersFirst -bool true

# When performing a search, search the current folder by default
run defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# Disable the warning when changing a file extension
run defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Spring loading for directories, with no delay
run defaults write NSGlobalDomain com.apple.springing.enabled -bool true
run defaults write NSGlobalDomain com.apple.springing.delay -float 0.5

# Avoid creating .DS_Store files on network or USB volumes
run defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
run defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# Disable disk image verification
run defaults write com.apple.frameworks.diskimages skip-verify -bool true
run defaults write com.apple.frameworks.diskimages skip-verify-locked -bool true
run defaults write com.apple.frameworks.diskimages skip-verify-remote -bool true

# Automatically open a new Finder window when a volume is mounted
run defaults write com.apple.frameworks.diskimages auto-open-ro-root -bool true
run defaults write com.apple.frameworks.diskimages auto-open-rw-root -bool true
run defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true

# Show the ~/Library folder
run chflags nohidden ~/Library

# Show the /Volumes folder. The one mutation here that needs root.
run sudo chflags nohidden /Volumes

# Desktop icon size and grid spacing.
# PlistBuddy `Set` fails on a fresh Mac where DesktopViewSettings:IconViewSettings
# does not exist yet, so create the entry first and fall back to setting it. The
# old code relied on this failing non-fatally, which strict mode no longer allows.
FINDER_PLIST="${HOME}/Library/Preferences/com.apple.finder.plist"
plist_set_int() {
    local key="$1" value="$2"
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '  PlistBuddy Set %s %s (%s)\n' "$key" "$value" "$FINDER_PLIST"
        return 0
    fi
    /usr/libexec/PlistBuddy -c "Add ${key} integer ${value}" "$FINDER_PLIST" 2>/dev/null ||
        /usr/libexec/PlistBuddy -c "Set ${key} ${value}" "$FINDER_PLIST"
}

plist_set_int "DesktopViewSettings:IconViewSettings:iconSize" 44
plist_set_int "DesktopViewSettings:IconViewSettings:gridSpacing" 60

section "Dock and Mission Control"

run defaults write com.apple.dock tilesize -int 36
run defaults write com.apple.dock mineffect -string "scale"
run defaults write com.apple.dock minimize-to-application -bool true
run defaults write com.apple.dock enable-spring-load-actions-on-all-items -bool false
run defaults write com.apple.dock show-process-indicators -bool false
run defaults write com.apple.dock launchanim -bool false
run defaults write com.apple.dock expose-animation-duration -float 0.1
run defaults write com.apple.dock expose-group-apps -bool true
run defaults write com.apple.dock mru-spaces -bool false
run defaults write com.apple.dock autohide -bool true
run defaults write com.apple.dock autohide-delay -float 0
run defaults write com.apple.dock autohide-time-modifier -float 0
run defaults write com.apple.dock showhidden -bool true
run defaults write com.apple.dock show-recents -bool false

# Disable "Displays have separate Spaces"
run defaults write com.apple.spaces spans-displays -bool true

# Removing the persistent-apps / persistent-others keys is bin/preferences-restore's
# job, and it prompts before doing it. Deliberately not done here.

section "Hot corners"

# 0 = None, 4 = Desktop, 10 = Put display to sleep, 12 = Notification Center

# Top left → None
run defaults write com.apple.dock wvous-tl-corner -int 0
run defaults write com.apple.dock wvous-tl-modifier -int 0

# Top right → Notification Center
run defaults write com.apple.dock wvous-tr-corner -int 12
run defaults write com.apple.dock wvous-tr-modifier -int 0

# Bottom left → Desktop
run defaults write com.apple.dock wvous-bl-corner -int 4
run defaults write com.apple.dock wvous-bl-modifier -int 0

# Bottom right → Put display to sleep.
# This block used to write wvous-bl-corner a second time, under a comment saying
# "bottom right". wvous-br-corner was never set at all, so the bottom-left corner
# silently ended up as "sleep display" and the intended Desktop corner was lost.
run defaults write com.apple.dock wvous-br-corner -int 10
run defaults write com.apple.dock wvous-br-modifier -int 0

section "Trackpad and mouse"

# Tracking speed: maximum 5.0. The mouse value was previously set to 1.5 and then
# overwritten with a *string* 5.0 further down, with a stray `defaults read`
# printing to stdout in between. One float write each.
run defaults write NSGlobalDomain com.apple.trackpad.scaling -float 5.0
run defaults write NSGlobalDomain com.apple.mouse.scaling -float 5.0

# Tap to click, for this user and for the login screen
run defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
run defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
run defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Map the bottom right corner to right-click
run defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadCornerSecondaryClick -int 2
run defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadRightClick -bool true
run defaults -currentHost write NSGlobalDomain com.apple.trackpad.trackpadCornerClickBehavior -int 1
run defaults -currentHost write NSGlobalDomain com.apple.trackpad.enableSecondaryClick -bool true

section "Windows"

# Move windows by dragging any part of the window (ctrl + cmd)
run defaults write NSGlobalDomain NSWindowShouldDragOnGesture -bool true

section "Restarting affected applications"

for app in "Dock" "Finder" "Messages" "SystemUIServer"; do
    # An app that is not running makes killall exit non-zero, which strict mode
    # would treat as fatal. Not running is a perfectly good outcome here.
    run killall "${app}" 2>/dev/null || true
done

echo
echo "Done. Note that some of these changes require a logout/restart to take effect."
