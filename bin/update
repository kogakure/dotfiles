#!/bin/bash

# Ask for the administrator password upfront
sudo -v

# Keep-alive: update existing `sudo` time stamp until script has finished
while true; do
    sudo -n true
    sleep 30
    kill -0 "$$" || exit
done 2>/dev/null &

cd ~/.dotfiles || {
    echo "update: cannot cd into ~/.dotfiles — aborting." >&2
    exit 1
}

# Update Homebrew
NONINTERACTIVE=1 brew update
brew outdated
NONINTERACTIVE=1 brew upgrade
brew cleanup

# Ruby
gem update --system --no-document
gem update --no-document
gem cleanup all

# Update tmux plugins
~/.tmux/plugins/tpm/bin/update_plugins all

# Update GitHub extensions
gh extension upgrade --all

# Update Fish plugins
# fisher is a fish *function*, not an executable — the brew formula ships only
# share/fish/vendor_functions.d/fisher.fish. It has to be driven through fish.
fish -c "fisher update"

# Update Neovim
nvim --headless "+Lazy! sync" +qa

# Maintenance
# `mo` is the binary shipped by the `mole` formula (https://mole.fit), which is
# in all three Brewfiles under that name — hence the guard, since the command
# and the package are spelled differently.
if command -v mo >/dev/null 2>&1; then
    mo clean
    mo optimize
else
    echo "update: mo not found — install the 'mole' formula. Skipping maintenance." >&2
fi

# Claude
claude-backup

# Codex
codex-backup

# Write Homebrew Brewfile
homebrew-backup

# Write preferences
preferences-backup

# Update macOS software
sudo softwareupdate -i -a
