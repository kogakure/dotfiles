#!/bin/bash

# `set -uo pipefail`, deliberately without -e: a broken tap or an offline plugin
# registry must not skip the ten steps after it. Every step goes through
# run_step instead, which keeps going and makes the run exit non-zero with the
# failing steps named. Previously every step's status was discarded and the run
# exited with softwareupdate's, so a failed backup was invisible.
set -uo pipefail

# Derived from this script's own location rather than a fixed ~/.dotfiles: that
# path is not necessarily *this* checkout, which matters with worktrees.
cd "$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || {
    echo "update: cannot cd to the repository root — aborting." >&2
    exit 1
}

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/privilege.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/privilege.sh" || exit 1

dotfiles_flags_init

# Ask once, keep the timestamp warm, and stop the refresher on the way out.
#
# This replaces a local copy of the loop that captured no PID and had no trap:
# the loop's own `kill -0 "$$"` check was the only thing stopping it, and it ran
# only after the sleep, so every interrupted run leaked a refresher for up to
# thirty seconds. It also sat above the `set` line and above the library, so it
# could use neither. See bin/lib/privilege.sh.
trap privilege_release EXIT
privilege_prime
privilege_keepalive

# Every step below goes through run_step, so one failure is reported by name in
# the summary instead of scrolling past and leaving the run's exit status to
# whatever happened to come last.

update_homebrew() {
    NONINTERACTIVE=1 brew update || return 1
    brew outdated
    NONINTERACTIVE=1 brew upgrade || return 1
    brew cleanup
}

update_ruby() {
    gem update --system --no-document || return 1
    gem update --no-document || return 1
    gem cleanup all
}

# rustup owns the Rust toolchain — mise deliberately does not declare rust, see
# config/mise/mise.toml's header (SI-123). Nothing kept the default current
# before this step existed, which is how macbook-2019 sat on a year-stale
# nightly until a cargo: backend needed a newer rustc and `mise install` broke.
# `rustup update` refreshes every installed toolchain and rustup itself.
update_rust() {
    if ! have rustup; then
        log_warn "rustup not found. Skipping Rust toolchain update."
        return 0
    fi
    rustup update
}

# Nothing updated mise's tools before this step existed — not even the ones
# declared "latest", which stayed at whatever version happened to be current
# when they were first installed (SI-122).
#
# `mise upgrade` respects the config: an exact pin does not move, and only a
# "latest" entry advances. That is what makes the pinned/tracked split in
# config/mise/mise.toml mean something — a pin you never update is honest, a
# "latest" that never moves is not.
update_mise() {
    if ! have mise; then
        log_warn "mise not found. Skipping tool upgrade."
        return 0
    fi
    # Non-interactive by default — `--interactive` is the opt-in. No prune
    # here: deleting installed versions is a separate, opt-in concern in this
    # repository, the same rule bin/lib/sync.sh follows for backups.
    mise upgrade
}

# `mo` is the binary shipped by the `mole` formula (https://mole.fit), which is
# in all three Brewfiles under that name — hence the guard, since the command
# and the package are spelled differently.
update_maintenance() {
    if ! have mo; then
        log_warn "mo not found — install the 'mole' formula. Skipping maintenance."
        return 0
    fi
    mo clean || return 1
    mo optimize
}

# herdr has no `plugin update` — re-running `plugin install` is the update path,
# so the set has to come from somewhere. It comes from the same file setup.sh
# installs from, which is the point of packages/: this script upgraded gh
# extensions and fish plugins but had no idea herdr plugins existed, so they were
# only ever installed and never updated.
# shellcheck disable=SC2329  # invoked indirectly, as run_step's command argument
update_herdr() {
    local plugin list rc=0

    if ! have herdr; then
        log_warn "herdr not found. Skipping plugin update."
        return 0
    fi

    # Captured, so a missing file fails loudly instead of updating nothing.
    list=$(package_list packages/herdr-plugins) || {
        log_err "update: cannot read packages/herdr-plugins"
        return 1
    }

    for plugin in $list; do
        run herdr plugin install "$plugin" --yes || rc=1
    done
    return "$rc"
}

# Wrapped in a function only so run_step can name it in the summary.
# shellcheck disable=SC2329  # invoked indirectly, as run_step's command argument
softwareupdate_all() {
    sudo softwareupdate -i -a
}

run_step homebrew update_homebrew
run_step mise update_mise
run_step ruby update_ruby
run_step rust update_rust
run_step "tmux plugins" "$HOME/.tmux/plugins/tpm/bin/update_plugins" all
run_step "gh extensions" gh extension upgrade --all
run_step "herdr plugins" update_herdr
# fisher is a fish *function*, not an executable — the brew formula ships only
# share/fish/vendor_functions.d/fisher.fish. It has to be driven through fish.
run_step "fish plugins" fish -c "fisher update"
run_step neovim nvim --headless "+Lazy! sync" +qa
run_step maintenance update_maintenance

# *** *** Backups *** ***

# One aggregator instead of four bare names. bin/dotfiles-backup checks the
# private submodule once, isolates each backup's failure from the others, and
# reports the failures in its exit code — none of which four bare calls could
# do.
#
# `./bin/…` rather than a bare name: the old calls resolved through PATH, which
# works only because session-variables.sh puts ~/.dotfiles/bin on it. That made
# bin/update depend on the shell configuration it is updating — a PATH
# regression would make all four backups vanish with "command not found" and,
# with no `set -e`, the run would carry on and still exit 0. It also ran
# whichever checkout came first on PATH rather than this one.
run_step backups ./bin/dotfiles-backup

# Update macOS software. Last, and still reached even when a step above failed,
# which is the reason this script does not use `set -e`.
run_step "macos software update" softwareupdate_all

step_summary || exit 1
