#!/bin/bash
#
# agentic-set-profile
# Sets the machine profile shared by agent backup and restore scripts.
#
# Usage: agentic-set-profile work|personal

set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

# "${1:-}" rather than "$1": under `set -u` an absent argument is an unbound
# variable, which would abort before the usage message below could print.
PROFILE="${1:-}"
PROFILE_FILE=$(profile_file)
LEGACY_PROFILE_FILE=$(profile_legacy_file)

if [ -z "$PROFILE" ]; then
    log_err "Usage: agentic-set-profile work|personal"
    exit 1
fi

assert_valid_profile "$PROFILE" profile || exit 1

echo "$PROFILE" >"$PROFILE_FILE"

log_done "Agentic profile set to: $PROFILE"
log_info "  Claude and Codex backups will use their respective $PROFILE directories."

if [ -f "$LEGACY_PROFILE_FILE" ]; then
    log_warn "  Legacy ~/.machine-profile remains supported and can now be removed."
fi
