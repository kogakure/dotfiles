#!/bin/bash
#
# Lint the shell sources of this dotfiles repository.
#
# This is the single source of truth for `just lint`, `.githooks/pre-commit`
# and `.github/workflows/ci.yml`, so all three check exactly the same things.
# It resolves its own repository root and never depends on the caller's cwd.
#
# Deliberately written for bash 3.2 (the /bin/bash macOS ships) so it still
# runs when PATH has been reduced to /usr/bin:/bin — see .githooks/pre-commit.
#
# Usage:
#   dotfiles-lint [OPTIONS] [CHECK...]
#
# Checks (default: all of them). The leading "-" keeps shellcheck from
# mistaking these lines for `# shellcheck ...` directives:
#   - shellcheck   over every bash/sh source, gated on .lint-baseline
#   - shfmt        -d -i 4 -ci over the same set (must be clean)
#   - fish         fish -n over the hand-written fish config and functions
#   - zsh          zsh -n over zshrc/zshenv (no zsh dialect in shellcheck)
#   - posix        source the startup files for real, assert stderr is empty
#   - yaml         parse install.conf.yaml, assert every link source exists
#   - unit         exercise the pure helpers in bin/lib/, and check that
#                  every "shellcheck source=" directive resolves
#   - manifest     parse bin/lib/preferences.manifest and assert it covers
#                  everything in private/preferences/
#   - owners       parse bin/lib/config-owners.manifest and assert it covers
#                  everything in config/ (SI-85)
#   - drift        re-run the shell-config generator, assert no diff (SI-84)
#
# Options:
#   --staged     only lint files staged for commit (used by the pre-commit hook)
#   --strict     a missing linter is an error instead of a skip; used in CI
#   --snapshot   rewrite .lint-baseline from the current findings
#   --list-shell-sources
#                print the bash/sh source list and exit; `just fmt` formats
#                exactly this set, so the formatter and the linter agree
#   -h, --help   show this help
#
# Exit status: 0 if every selected check passed or was skipped, 1 otherwise.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASELINE_FILE="$REPO_ROOT/.lint-baseline"

STAGED=0
STRICT=0
SNAPSHOT=0
LIST_ONLY=0
CHECKS=()
FAILED=()
SKIPPED=()

ALL_CHECKS="shellcheck shfmt fish zsh posix yaml unit manifest owners drift"

# --- output helpers ---------------------------------------------------------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BOLD=$'\033[1m' C_OFF=$'\033[0m'
else
    C_RED='' C_GREEN='' C_YELLOW='' C_BOLD='' C_OFF=''
fi

heading() { printf '%s==> %s%s\n' "$C_BOLD" "$1" "$C_OFF"; }
ok() { printf '%s    ok%s %s\n' "$C_GREEN" "$C_OFF" "$1"; }
warn() { printf '%s  skip%s %s\n' "$C_YELLOW" "$C_OFF" "$1"; }
fail() { printf '%s  FAIL%s %s\n' "$C_RED" "$C_OFF" "$1"; }

usage() {
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# Report a check as skipped, or as failed when --strict is in effect.
missing_tool() {
    if [ "$STRICT" -eq 1 ]; then
        fail "$1: '$2' not found (--strict)"
        FAILED[${#FAILED[@]}]="$1"
    else
        warn "$1: '$2' not found, skipping"
        SKIPPED[${#SKIPPED[@]}]="$1"
    fi
}

# Read newline-separated stdin into the global FILES array. A single global
# rather than a by-name out-parameter, because bash 3.2 has no namerefs and
# the `eval` alternative is worse than the coupling. Checks run one at a time,
# so there is never more than one live file list.
FILES=()
read_files() {
    local line
    FILES=()
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        FILES[${#FILES[@]}]=$line
    done
}

# --- argument parsing -------------------------------------------------------

while [ $# -gt 0 ]; do
    case "$1" in
        --staged) STAGED=1 ;;
        --strict) STRICT=1 ;;
        --snapshot) SNAPSHOT=1 ;;
        --list-shell-sources) LIST_ONLY=1 ;;
        -h | --help) usage 0 ;;
        -*)
            printf 'dotfiles-lint: unknown option %s\n' "$1" >&2
            exit 1
            ;;
        *)
            case " $ALL_CHECKS " in
                *" $1 "*) CHECKS[${#CHECKS[@]}]="$1" ;;
                *)
                    printf 'dotfiles-lint: unknown check %s (want: %s)\n' "$1" "$ALL_CHECKS" >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
    shift
done

if [ ${#CHECKS[@]} -eq 0 ]; then
    # shellcheck disable=SC2206,SC2086 # deliberate word split of the check list
    CHECKS=($ALL_CHECKS)
fi

cd "$REPO_ROOT" || exit 1

# --- file discovery ---------------------------------------------------------
#
# Every list is derived from git or from a shebang, so vendored files that are
# gitignored stay out and nothing has to be re-listed by hand when a script is
# added or removed.

# Files staged for commit (added/copied/modified/renamed — never deleted).
staged_files() {
    git diff --cached --name-only --diff-filter=ACMR
}

# True when $1 has a shebang for an interpreter we do not lint as shell.
is_foreign_script() {
    local shebang
    IFS= read -r shebang <"$1" || return 1
    case "$shebang" in
        '#!'*python* | '#!'*node* | '#!'*ruby* | '#!'*perl* | '#!'*osascript*) return 0 ;;
    esac
    return 1
}

# bash/sh sources. bin/convert-2-imdb3-format.sh is bash wrapping a python
# heredoc, so it stays in; bin/key_counter_summary.py and bin/gource-gravatars
# drop out by their shebangs, not by their names.
#
# generated/ is enumerated by hand, and is the one place in this file where that
# is true: everything else is a glob over a directory whose contents are
# discovered. bin/generate-shell-config's output has to be held to the same bar
# as hand-written code — shfmt is a hard zero, so a generator that emits
# unformatted bash would put shfmt and drift into a fight neither can win.
shell_sources() {
    local f
    for f in \
        setup.sh install \
        bin/* bin/lib/*.sh functions/*.sh .githooks/* \
        generated/*.sh generated/hooks.bash \
        bashrc bash_profile profile; do
        [ -f "$f" ] || continue
        is_foreign_script "$f" && continue
        printf '%s\n' "$f"
    done
}

# zsh sources. shellcheck has no zsh dialect, so these only get `zsh -n`.
zsh_sources() {
    local f
    for f in zshrc zshenv generated/hooks.zsh; do
        [ -f "$f" ] && printf '%s\n' "$f"
    done
    return 0
}

# Hand-written fish sources. The 20-odd vendored fisher functions under
# config/fish/functions are gitignored and untracked, so git filters them out
# and this list needs no maintenance when a fisher plugin is added.
#
# git's pathspec `*` matches across `/`, so the four generated
# config/fish/conf.d/*.fish files are covered by the same pattern as the
# hand-written ones — and they are tracked, since .gitignore now names the
# vendored fisher files individually instead of ignoring the directory.
fish_sources() {
    git ls-files -- 'config/fish/*.fish' 'generated/hooks.fish'
}

# Intersect a discovery function's output with the staged set when --staged.
select_files() {
    if [ "$STAGED" -eq 0 ]; then
        "$1"
        return 0
    fi
    comm -12 <("$1" | sort) <(staged_files | sort)
}

# --- shellcheck -------------------------------------------------------------
#
# Gated on "no more findings than the snapshot in .lint-baseline", not on zero.
# Fixing the pre-existing findings is SI-81/SI-82 work; this phase only has to
# stop the count from growing.

baseline_count() {
    local n
    n=$(sed -n 's/^shellcheck=\([0-9]\{1,\}\)$/\1/p' "$BASELINE_FILE" 2>/dev/null | tail -1)
    printf '%s' "${n:-0}"
}

write_baseline() {
    cat >"$BASELINE_FILE" <<EOF
# Snapshot of the shellcheck findings that already existed when the lint gate
# was introduced (SI-80). \`just lint\` fails when the count goes *up*, so new
# code is held to a clean bar without this phase silently absorbing the
# cleanup that belongs to SI-81 and SI-82.
#
# Regenerate with: just lint-snapshot
shellcheck=$1
EOF
}

check_shellcheck() {
    heading "shellcheck"
    if ! command -v shellcheck >/dev/null 2>&1; then
        missing_tool shellcheck shellcheck
        return
    fi

    read_files < <(select_files shell_sources)
    if [ ${#FILES[@]} -eq 0 ]; then
        ok "no shell sources to check"
        return
    fi

    # -s bash: bashrc, aliases and functions/*.sh have no shebang but are bash.
    local findings count
    findings=$(shellcheck -x -s bash -f gcc "${FILES[@]}" 2>/dev/null)
    if [ -n "$findings" ]; then
        count=$(printf '%s\n' "$findings" | wc -l | tr -d ' ')
    else
        count=0
    fi

    if [ "$SNAPSHOT" -eq 1 ]; then
        write_baseline "$count"
        ok "snapshotted $count finding(s) into .lint-baseline"
        return
    fi

    # --staged lints a subset, so comparing its count to the whole-repo
    # baseline is meaningless. Require the staged files to be clean instead.
    if [ "$STAGED" -eq 1 ]; then
        if [ "$count" -gt 0 ]; then
            printf '%s\n' "$findings"
            fail "shellcheck: $count finding(s) in staged files"
            FAILED[${#FAILED[@]}]=shellcheck
        else
            ok "${#FILES[@]} staged file(s) clean"
        fi
        return
    fi

    local baseline
    baseline=$(baseline_count)
    if [ "$count" -gt "$baseline" ]; then
        printf '%s\n' "$findings"
        fail "shellcheck: $count finding(s), baseline is $baseline"
        printf '       Fix the new finding, or add a per-line\n'
        printf '       "# shellcheck disable=SCxxxx" with a reason comment.\n'
        FAILED[${#FAILED[@]}]=shellcheck
    elif [ "$count" -lt "$baseline" ]; then
        ok "$count finding(s), below the baseline of $baseline"
        printf '       Findings went down — lock it in with: just lint-snapshot\n'
    else
        ok "$count finding(s), at the baseline of $baseline"
    fi
}

# --- shfmt ------------------------------------------------------------------

check_shfmt() {
    heading "shfmt"
    if ! command -v shfmt >/dev/null 2>&1; then
        missing_tool shfmt shfmt
        return
    fi

    read_files < <(select_files shell_sources)
    if [ ${#FILES[@]} -eq 0 ]; then
        ok "no shell sources to check"
        return
    fi

    local diff
    diff=$(shfmt -d -i 4 -ci "${FILES[@]}" 2>&1)
    if [ -n "$diff" ]; then
        printf '%s\n' "$diff"
        fail "shfmt: formatting differs in the diff above. Run: just fmt"
        FAILED[${#FAILED[@]}]=shfmt
    else
        ok "${#FILES[@]} file(s) formatted"
    fi
}

# --- fish / zsh syntax ------------------------------------------------------

check_syntax() {
    local label=$1 tool=$2 sources=$3 check=$4
    heading "$label"
    if ! command -v "$tool" >/dev/null 2>&1; then
        missing_tool "$check" "$tool"
        return
    fi

    read_files < <(select_files "$sources")
    if [ ${#FILES[@]} -eq 0 ]; then
        ok "nothing to check"
        return
    fi

    local bad=0 f
    for f in "${FILES[@]}"; do
        "$tool" -n "$f" || bad=1
    done
    if [ "$bad" -eq 1 ]; then
        fail "$label: syntax errors above"
        FAILED[${#FAILED[@]}]="$check"
    else
        ok "${#FILES[@]} file(s) parse"
    fi
}

check_fish() { check_syntax "fish -n" fish fish_sources fish; }
check_zsh() { check_syntax "zsh -n" zsh zsh_sources zsh; }

# --- POSIX runtime source test ----------------------------------------------
#
# The highest-value check in the suite. `bash -n` happily parses fish-syntax
# aliases such as `alias e "emacs -nw"` — only actually sourcing the file
# catches them, and only stderr (not the exit status) reveals them.
#
# bashrc and zshrc are deliberately absent: they are interactive-shell config
# full of `eval "$(tool init ...)"` whose output depends on which tools happen
# to be installed, so their stderr is not a stable signal. The syntax checks
# above cover them instead.

# The generated pair replaced the hand-written `aliases` and
# `session-variables.sh` at the repo root. Sourcing them for real matters more
# now, not less: a generator bug reaches every shell at once.
POSIX_TARGETS="generated/aliases.sh generated/session-variables.sh profile bash_profile"

# The files a sandbox $HOME needs, as "<dotfile-name> <repo-path>" pairs. Taken
# from install.conf.yaml — every startup file that another one sources. The
# names on the left are what the startup files reach for; only the repo-side
# targets moved.
POSIX_SANDBOX_LINKS="\
.aliases:generated/aliases.sh
.session-variables.sh:generated/session-variables.sh
.profile:profile
.bash_profile:bash_profile
.bashrc:bashrc
.functions:functions"

# Build a throwaway $HOME containing just the dotbot symlinks the startup
# files reach for. Without it this check would pass or fail depending on
# whether the *installed* ~/.session-variables.sh happens to exist, which is
# exactly the kind of accidental pass a lint gate must not have.
posix_sandbox_create() {
    local dir pair
    dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint.XXXXXX") || return 1
    for pair in $POSIX_SANDBOX_LINKS; do
        ln -s "$REPO_ROOT/${pair#*:}" "$dir/${pair%%:*}" || return 1
    done
    printf '%s' "$dir"
}

# Remove the sandbox by name rather than with `rm -rf`: it contains nothing but
# the symlinks created above, so there is no reason to reach for a recursive
# delete inside a dotfiles repo.
posix_sandbox_remove() {
    local dir=$1 pair
    [ -n "$dir" ] && [ -d "$dir" ] || return 0
    for pair in $POSIX_SANDBOX_LINKS; do
        [ -L "$dir/${pair%%:*}" ] && rm -f "$dir/${pair%%:*}"
    done
    rmdir "$dir" 2>/dev/null
    return 0
}

check_posix() {
    heading "startup files source cleanly"

    local have_zsh=0
    command -v zsh >/dev/null 2>&1 && have_zsh=1

    local sandbox
    if ! sandbox=$(posix_sandbox_create) || [ -z "$sandbox" ]; then
        fail "could not create the sandbox HOME"
        FAILED[${#FAILED[@]}]=posix
        return
    fi

    local bad=0 f err
    for f in $POSIX_TARGETS; do
        [ -f "$f" ] || continue

        err=$(HOME="$sandbox" bash --noprofile --norc -c '. "$1"' _ "$REPO_ROOT/$f" 2>&1 >/dev/null)
        if [ -n "$err" ]; then
            bad=1
            fail "bash: sourcing $f wrote to stderr"
            printf '%s\n' "$err" | sed 's/^/       /'
        fi

        [ "$have_zsh" -eq 1 ] || continue
        err=$(HOME="$sandbox" zsh -f -c '. "$1"' _ "$REPO_ROOT/$f" 2>&1 >/dev/null)
        if [ -n "$err" ]; then
            bad=1
            fail "zsh: sourcing $f wrote to stderr"
            printf '%s\n' "$err" | sed 's/^/       /'
        fi
    done

    posix_sandbox_remove "$sandbox"

    [ "$have_zsh" -eq 1 ] || warn "zsh not found, only checked bash"

    if [ "$bad" -eq 1 ]; then
        FAILED[${#FAILED[@]}]=posix
    else
        ok "startup files source silently in a sandbox HOME"
    fi
}

# --- install.conf.yaml ------------------------------------------------------
#
# Parse the dotbot config and assert every `link:` source exists on disk.
# private/* is excluded: the submodule is unavailable in CI and on any machine
# that has not been granted access to it.

check_yaml() {
    heading "install.conf.yaml"
    if ! command -v yq >/dev/null 2>&1; then
        missing_tool yaml yq
        return
    fi

    if ! yq -e 'type == "!!seq"' install.conf.yaml >/dev/null 2>&1; then
        fail "install.conf.yaml: not a valid dotbot config (expected a YAML list)"
        FAILED[${#FAILED[@]}]=yaml
        return
    fi

    # For each link entry emit its source path. `.path // .` yields `path:` for
    # a glob entry (a map) and the value itself for a plain scalar mapping.
    local sources bad=0 src
    if ! sources=$(yq -r '.[] | select(has("link")) | .link | .[] | (.path // .)' install.conf.yaml); then
        fail "install.conf.yaml: could not extract link sources with yq"
        FAILED[${#FAILED[@]}]=yaml
        return
    fi

    while IFS= read -r src; do
        [ -n "$src" ] || continue
        case "$src" in
            private/*) continue ;;
            # A glob source only needs an existing parent directory.
            */\*)
                [ -d "${src%/\*}" ] || {
                    bad=1
                    fail "link source missing: $src"
                }
                ;;
            *)
                [ -e "$src" ] || {
                    bad=1
                    fail "link source missing: $src"
                }
                ;;
        esac
    done <<<"$sources"

    if [ "$bad" -eq 1 ]; then
        FAILED[${#FAILED[@]}]=yaml
    else
        ok "parses, and every non-private link source exists"
    fi
}

# --- unit tests for the pure helpers in bin/lib/ -----------------------------
#
# This check is the reason bin/lib/shells.sh exists as its own file.
# `register_login_shell` writes to /etc/shells behind sudo, so it can never be a
# lint gate — but it delegates the interesting part to a transformation that
# takes the shells file as an argument, and that part is testable here with no
# privileges and no fresh machine.
#
# The criterion this replaces was "exactly one fish entry after two consecutive
# setup.sh runs" (SI-81), which only a VM could ever have shown. The fixtures
# below cover that fresh-machine case *and* the repair case the three real
# machines were actually in — four accumulated duplicates — which the original
# wording did not ask about at all.

UNIT_SHELL=/opt/homebrew/bin/fish

# A fixture holding two unrelated shells plus $1 copies of UNIT_SHELL.
unit_fixture() {
    local n=$1 f i=0
    f=$(mktemp "${TMPDIR:-/tmp}/dotfiles-lint-shells.XXXXXX") || return 1
    printf '%s\n%s\n' /bin/sh /bin/bash >"$f"
    while [ "$i" -lt "$n" ]; do
        printf '%s\n' "$UNIT_SHELL" >>"$f"
        i=$((i + 1))
    done
    printf '%s' "$f"
}

# Apply the transformation to $1 in place.
unit_apply() {
    local desired
    desired=$(shells_file_desired "$UNIT_SHELL" "$1") || return 1
    printf '%s\n' "$desired" >"$1"
}

# A file under bin/lib/ is a tracked file, not an optional external tool, so a
# missing one is a repository defect. missing_tool() above is for tools; this
# fails outright, including without --strict, because the previous skip meant
# `git rm bin/lib/shells.sh` passed CI green.
#
# Usage: unit_require <path>
unit_require() {
    if [ ! -f "$1" ]; then
        fail "unit: $1 is missing"
        return 1
    fi
    return 0
}

# Compare one expected value against one actual value.
# Usage: unit_expect <label> <want> <got>
unit_expect() {
    local label=$1 want=$2 got=$3
    [ "$want" = "$got" ] && return 0
    fail "unit: $label: want '$want', got '$got'"
    return 1
}

# Print <file> with comments removed, for the checks that assert a property of
# the *code* in a file rather than of its text.
#
# Not a nicety: unit_brew_no_force asserts that "cleanup --force" appears in one
# place, and both files that must not run it explain at length why they must not
# run it. Grepping the raw text finds the prose and reports the documentation as
# the defect. Deliberately named without the unit_ prefix — every unit_* name in
# this file is a test in check_unit's list, and one that is not would read as a
# dead test.
#
# Usage: strip_comments <file>
strip_comments() { sed 's/#.*//' "$1"; }

# `disable=SC1091` in .shellcheckrc means a `# shellcheck source=` directive
# pointing at a file that does not exist is completely silent — shellcheck
# reports nothing for setup.sh when run from a cwd where its directive cannot
# resolve. So `external-sources=true` cannot police its own directives, and the
# directive is documentation unless something checks it. This is that something.
#
# Both spellings are accepted: repo-relative (bin/lib/shells.sh, what setup.sh
# used before SI-82) and SCRIPTDIR-relative (lib/common.sh, the cwd-independent
# form the bin/ scripts use). `source=/dev/null` is shellcheck's own idiom for
# "deliberately not resolvable" — bashrc:75 sources user-supplied files — so it
# is exempt rather than a finding.
unit_source_directives() {
    local bad=0 f target
    while IFS= read -r f; do
        while IFS= read -r target; do
            [ -n "$target" ] || continue
            [ "$target" = /dev/null ] && continue
            [ -f "$target" ] && continue
            [ -f "${f%/*}/$target" ] && continue
            bad=1
            fail "unit: $f: 'shellcheck source=$target' does not resolve"
        done < <(sed -n 's/^[[:space:]]*#[[:space:]]*shellcheck.*source=\([^ ]*\).*/\1/p' "$f")
    done < <(shell_sources)

    [ "$bad" -eq 0 ] && ok "every 'shellcheck source=' directive resolves"
    return "$bad"
}

unit_shells() {
    unit_require bin/lib/shells.sh || return 1
    # shellcheck source=bin/lib/shells.sh
    . bin/lib/shells.sh

    local bad=0 start f first second
    for start in 0 1 2 4; do
        if ! f=$(unit_fixture "$start"); then
            fail "unit: could not create a fixture"
            return 1
        fi

        # Twice: the second application must be a no-op, which is the whole
        # idempotency claim.
        unit_apply "$f"
        first=$(grep -cxF -- "$UNIT_SHELL" "$f" | tr -d ' ')
        unit_apply "$f"
        second=$(grep -cxF -- "$UNIT_SHELL" "$f" | tr -d ' ')

        if [ "$first" != 1 ] || [ "$second" != 1 ]; then
            bad=1
            fail "unit: starting from $start, got $first then $second (want 1 then 1)"
        fi

        # The collapse rewrites the whole file, so prove it preserves the rest.
        if ! grep -qxF -- /bin/sh "$f" || ! grep -qxF -- /bin/bash "$f"; then
            bad=1
            fail "unit: starting from $start, unrelated shell entries were lost"
        fi
        if [ "$(head -1 "$f")" != /bin/sh ]; then
            bad=1
            fail "unit: starting from $start, original ordering was not preserved"
        fi

        rm -f "$f"
    done

    [ "$bad" -eq 0 ] && ok "shells_file_desired is idempotent from 0, 1, 2 and 4 entries"
    return "$bad"
}

# brew_prefix_choose is the pure half of brew_prefix. The acceptance criterion
# names "both an Apple Silicon and the Intel machine", and only one of the two
# exists here — so the decision is checked against a supplied architecture and
# candidate list instead of against the machine the linter happens to run on.
unit_brew_prefix() {
    unit_require bin/lib/util.sh || return 1
    (
        # A subshell: util.sh reads $_DL_ROOT, and sourcing it into the linter
        # would also drop `have` and `confirm` into the linter's namespace.
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/util.sh
        . bin/lib/util.sh

        bad=0
        unit_expect "arm64, both installed" /opt/homebrew \
            "$(brew_prefix_choose arm64 /opt/homebrew /usr/local)" || bad=1
        unit_expect "x86_64, both installed" /usr/local \
            "$(brew_prefix_choose x86_64 /opt/homebrew /usr/local)" || bad=1
        unit_expect "arm64, only /usr/local" /usr/local \
            "$(brew_prefix_choose arm64 /usr/local)" || bad=1
        unit_expect "x86_64, only /opt/homebrew" /opt/homebrew \
            "$(brew_prefix_choose x86_64 /opt/homebrew)" || bad=1
        unit_expect "arm64, nothing installed" /opt/homebrew \
            "$(brew_prefix_choose arm64)" || bad=1
        unit_expect "x86_64, nothing installed" /usr/local \
            "$(brew_prefix_choose x86_64)" || bad=1

        [ "$bad" -eq 0 ] && ok "brew_prefix_choose is right on arm64 and x86_64"
        exit "$bad"
    )
}

# host_id keys the per-host Brewfile and the backup manifests, so an override
# that silently did not take would send every one of them somewhere wrong.
unit_host_id() {
    unit_require bin/lib/util.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/util.sh
        . bin/lib/util.sh

        bad=0
        unit_expect "DOTFILES_HOST wins" some-other-mac \
            "$(DOTFILES_HOST=some-other-mac host_id)" || bad=1
        unit_expect "unset falls back to hostname -s" "$(hostname -s)" \
            "$(
                unset DOTFILES_HOST 2>/dev/null
                host_id
            )" || bad=1

        # An empty value is not a host name. `:-` rather than `-` is what makes
        # DOTFILES_HOST='' behave like unset instead of resolving every
        # host-keyed path to a bare directory.
        unit_expect "empty is treated as unset" "$(hostname -s)" \
            "$(DOTFILES_HOST='' host_id)" || bad=1

        unit_expect "brewfile_path is host-keyed and absolute" \
            "$REPO_ROOT/homebrew/some-other-mac" \
            "$(DOTFILES_HOST=some-other-mac brewfile_path)" || bad=1

        [ "$bad" -eq 0 ] && ok "host_id honours DOTFILES_HOST and falls back to hostname -s"
        exit "$bad"
    )
}

# brewfile_hosts is what a host mismatch prints, so it has to be right exactly
# when nothing else is working. Driven from a fixture rather than homebrew/,
# for the reason unit_packages gives: the machine running the linter is one of
# the hosts, so it cannot produce the interesting cases by itself.
unit_brewfile_hosts() {
    unit_require bin/lib/util.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/util.sh
        . bin/lib/util.sh

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-brewfiles.XXXXXX") || exit 1

        : >"$d/alpha"
        : >"$d/beta"
        mkdir -p "$d/a-directory"
        unit_expect "files are listed, directories are not" "alpha beta" \
            "$(brewfile_hosts "$d" | sort | tr '\n' ' ' | sed 's/ $//')" || bad=1

        rm -f "$d"/alpha "$d"/beta
        rmdir "$d/a-directory"
        unit_expect "an empty directory lists nothing" "" \
            "$(brewfile_hosts "$d")" || bad=1
        rmdir "$d"

        unit_expect "a missing directory lists nothing" "" \
            "$(brewfile_hosts "$d/gone")" || bad=1

        # And the real one, where being empty would mean setup.sh's preflight
        # tells a mismatched host to pick from an empty list.
        n=$(brewfile_hosts | grep -c .)
        if [ "$n" -eq 0 ]; then
            fail "unit: homebrew/ holds no Brewfiles"
            bad=1
        fi

        [ "$bad" -eq 0 ] && ok "brewfile_hosts lists files only, and homebrew/ is not empty"
        exit "$bad"
    )
}

# The SI-119 property, and the reason bin/lib/brew.sh exists as a separate file.
#
# `brew bundle cleanup --force` uninstalls every formula and cask absent from
# the named Brewfile — 368 and 121 of them on this machine, unattended, with no
# undo. bin/homebrew-restore ran it on line 46 of every invocation. Putting the
# call behind a flag is not enough on its own: the thing worth pinning is that
# it stays behind the flag, so reinstating the old line fails the gate.
#
# A text property rather than a behavioural one, deliberately. Running the real
# thing to find out whether it uninstalls is not a test anyone can afford.
unit_brew_no_force() {
    unit_require bin/lib/brew.sh || return 1
    unit_require bin/homebrew-restore || return 1
    local bad=0 n apply_line confirm_line

    # The destructive string lives in exactly one place. Comments are stripped
    # first: both files explain at length why they must not run it, and
    # grepping the raw text reports that documentation as the defect.
    n=$(strip_comments bin/homebrew-restore | grep -c 'cleanup --force')
    if [ "$n" -ne 0 ]; then
        fail "unit: bin/homebrew-restore runs 'cleanup --force' directly ($n time(s))"
        bad=1
    fi
    n=$(strip_comments bin/lib/brew.sh | grep -c 'cleanup --force')
    if [ "$n" -ne 1 ]; then
        fail "unit: bin/lib/brew.sh should run exactly one 'cleanup --force', found $n"
        bad=1
    fi

    # It is routed through run(), or --dry-run would uninstall for real.
    if ! strip_comments bin/lib/brew.sh | grep -q 'run brew bundle cleanup --force'; then
        fail "unit: brew_prune_apply does not go through run(); --dry-run would delete"
        bad=1
    fi

    # One call site, and it is downstream of a confirmation. sed blanks comments
    # rather than deleting them, so grep -n still reports real line numbers.
    n=$(strip_comments bin/homebrew-restore | grep -c '^[[:space:]]*brew_prune_apply ')
    if [ "$n" -ne 1 ]; then
        fail "unit: brew_prune_apply should have exactly one call site, found $n"
        bad=1
    fi
    apply_line=$(strip_comments bin/homebrew-restore |
        grep -n '^[[:space:]]*brew_prune_apply ' | head -1 | cut -d: -f1)
    confirm_line=$(strip_comments bin/homebrew-restore |
        grep -n 'confirm "' | head -1 | cut -d: -f1)
    if [ -z "$confirm_line" ] || [ -z "$apply_line" ] || [ "$confirm_line" -ge "$apply_line" ]; then
        fail "unit: brew_prune_apply is not called after a confirm() prompt"
        bad=1
    fi

    # And --prune cannot arrive through the environment channel that
    # bin/dotfiles-backup exports, which is what makes it argv-only.
    # shellcheck disable=SC2016  # a literal grep pattern; expanding it is the bug
    if strip_comments bin/homebrew-restore | grep -q 'PRUNE=${DOTFILES_PRUNE'; then
        fail "unit: --prune is seeded from DOTFILES_PRUNE; it must be argv-only"
        bad=1
    fi

    # brew.sh stays out of every script's namespace: common.sh must not source
    # it, for the reason it already declines to source shells.sh.
    if strip_comments bin/lib/common.sh | grep -q 'brew\.sh'; then
        fail "unit: bin/lib/common.sh sources brew.sh; the uninstall must stay opt-in"
        bad=1
    fi

    [ "$bad" -eq 0 ] && ok "the only 'cleanup --force' is in brew_prune_apply, behind --prune and a confirm"
    return "$bad"
}

# The three Brewfile analysers dotfiles-doctor reports from.
#
# Fixtures rather than homebrew/, and fixtures that carry the defects rather
# than clean ones: the real files' contents change on every `bin/update`, so a
# test written against them would pass or fail by accident of what happened to
# be installed the day it ran. The rows below are the four shapes
# docs/architecture.md records as known data bugs, reduced to their minimum.
unit_brew_analysers() {
    unit_require bin/lib/brew.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/util.sh
        . bin/lib/util.sh
        # shellcheck source=bin/lib/brew.sh
        . bin/lib/brew.sh

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-brewfiles-a.XXXXXX") || exit 1

        # One app re-listed under a new App Store ID while the old entry stayed,
        # inside a single file. The Pages case.
        # And a tap pinned to another owner's repository: the sst/anomalyco one.
        cat >"$d/host-a" <<'FIXTURE'
tap "acme/tap", "https://github.com/other-co/homebrew-tap.git", trusted: true
tap "casing/tap", "https://github.com/Casing/homebrew-tap.git"
brew "widget"
brew "shared"
mas "Pages", id: 361309726
mas "Pages", id: 409201541
mas "Editor", id: 111
FIXTURE

        # The same formula spelled bare on one host and tap-qualified on the
        # other, and the same App Store id dumped under a different name.
        cat >"$d/host-b" <<'FIXTURE'
brew "vendor/tap/widget"
brew "shared"
mas "Editor 2", id: 111
FIXTURE

        unit_expect "one name under two ids, and one id under two names" \
            'mas "Pages" has several ids: 361309726 409201541|mas id 111 has several names: Editor Editor 2' \
            "$(brewfile_mas_conflicts "$d/host-a" "$d/host-b" | tr '\n' '|' | sed 's/|$//')" || bad=1

        unit_expect "bare and tap-qualified spellings of one formula" \
            'brew "widget" is spelled several ways: widget(host-a) vendor/tap/widget(host-b)' \
            "$(brewfile_tap_drift "$d/host-a" "$d/host-b")" || bad=1

        # A formula spelled the same way on both hosts is not drift, or every
        # shared package would be a finding.
        if brewfile_tap_drift "$d/host-a" "$d/host-b" | grep -q '"shared"'; then
            fail "unit: brewfile_tap_drift reported a consistently spelled formula"
            bad=1
        fi

        unit_expect "a tap served from another owner" \
            'tap "acme/tap" is served from other-co (host-a)' \
            "$(brewfile_tap_url_drift "$d/host-a" "$d/host-b")" || bad=1

        # GitHub owners are case-insensitive, so `casing/tap` served from
        # .../Casing/... is one account written two ways. Reporting it would be
        # the kind of noise that gets a check ignored.
        if brewfile_tap_url_drift "$d/host-a" | grep -qi 'casing'; then
            fail "unit: brewfile_tap_url_drift reported a mere case difference"
            bad=1
        fi

        # Clean input yields nothing at all — the property that makes a zero
        # exit meaningful.
        printf 'brew "one"\nmas "App", id: 5\n' >"$d/clean"
        unit_expect "a clean Brewfile yields no findings" "" \
            "$(
                brewfile_mas_conflicts "$d/clean"
                brewfile_tap_drift "$d/clean"
                brewfile_tap_url_drift "$d/clean"
            )" || bad=1

        rm -f "$d"/host-a "$d"/host-b "$d"/clean
        rmdir "$d"
        [ "$bad" -eq 0 ] && ok "the Brewfile analysers find each known defect and nothing else"
        exit "$bad"
    )
}

# The ticket's "colour codes are currently emitted even when output is piped".
# Captured in a command substitution, so stdout is a pipe, so every log_*
# function must emit no escape sequence at all.
unit_log_plain() {
    unit_require bin/lib/log.sh || return 1
    local out
    out=$(
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        log_info info
        log_step step
        log_field label value
        log_ok ok
        log_skip skip
        log_note note
        log_warn warn
        log_done finished
    )
    case $out in
        *$'\033'*)
            fail "unit: log_* emitted colour into a pipe"
            return 1
            ;;
    esac
    ok "log_* emits no colour when stdout is not a terminal"
    return 0
}

# Three of the four agent scripts validated nothing, so a typo in
# ~/.agentic-profile silently produced private/claude/<typo>/. profile_read is
# pure and takes its paths as arguments, so the whitespace and fallback cases
# are checked here against fixtures rather than against the real $HOME.
unit_profile() {
    unit_require bin/lib/profile.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/profile.sh
        . bin/lib/profile.sh

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-profile.XXXXXX") || exit 1

        printf 'work\n' >"$d/plain"
        printf '  work  \n' >"$d/padded"
        printf 'personal\n\n\n' >"$d/trailing"
        : >"$d/empty"
        printf 'garbage\n' >"$d/garbage"

        unit_expect "plain file" work "$(profile_read "$d/plain")" || bad=1
        # `read` trims with the default IFS, which `cat` did not.
        unit_expect "padded file" work "$(profile_read "$d/padded")" || bad=1
        unit_expect "trailing blank lines" personal "$(profile_read "$d/trailing")" || bad=1
        unit_expect "empty file falls through" personal "$(profile_read "$d/empty")" || bad=1
        unit_expect "absent file falls through" personal "$(profile_read "$d/nope")" || bad=1
        # The fallback chain: first readable non-empty file wins.
        unit_expect "second file used" work "$(profile_read "$d/nope" "$d/plain")" || bad=1
        unit_expect "first file wins" personal "$(profile_read "$d/trailing" "$d/plain")" || bad=1

        profile_is_valid work || {
            fail "unit: profile_is_valid rejected work"
            bad=1
        }
        profile_is_valid personal || {
            fail "unit: profile_is_valid rejected personal"
            bad=1
        }
        for junk in garbage '' Work WORK 'work personal' ../escape; do
            if profile_is_valid "$junk"; then
                fail "unit: profile_is_valid accepted '$junk'"
                bad=1
            fi
        done

        rm -f "$d"/plain "$d"/padded "$d"/trailing "$d"/empty "$d"/garbage
        rmdir "$d"

        [ "$bad" -eq 0 ] && ok "profile_read trims and falls back; only work|personal validate"
        exit "$bad"
    )
}

unit_conflicts() {
    unit_require bin/lib/sync.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/common.sh
        . bin/lib/common.sh

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-sync.XXXXXX") || exit 1
        printf 'a\n' >"$d/src1"
        printf 'b\n' >"$d/dest1"
        printf 'c\n' >"$d/src2"
        # src3 has no dest; dest4 has no src. Neither is a conflict.
        printf 'd\n' >"$d/src3"
        printf 'e\n' >"$d/dest4"

        unit_expect "one collision reported" "$d/dest1" \
            "$(sync_conflicts "$d/src1" "$d/dest1" "$d/src2" "$d/dest2")" || bad=1
        unit_expect "no collision is empty" "" \
            "$(sync_conflicts "$d/src3" "$d/dest3" "$d/src4" "$d/dest4")" || bad=1
        unit_expect "an odd trailing argument is ignored" "" \
            "$(sync_conflicts "$d/src3")" || bad=1

        rm -f "$d"/src1 "$d"/dest1 "$d"/src2 "$d"/src3 "$d"/dest4
        rmdir "$d"
        [ "$bad" -eq 0 ] && ok "sync_conflicts reports only real collisions"
        exit "$bad"
    )
}

# The highest-value test in SI-82. codex-backup used to rm the destination when
# the source was absent, which on a non-host-namespaced private/ deletes another
# machine's committed backup. Reverting backup_file or backup_dir to that
# behaviour fails exactly here.
unit_no_prune() {
    unit_require bin/lib/sync.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/common.sh
        . bin/lib/common.sh
        dotfiles_flags_init

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-noprune.XXXXXX") || exit 1

        # A destination that exists while its source does not: the other
        # machine's backup. It must survive.
        printf 'other machine\n' >"$d/stale-file"
        mkdir -p "$d/stale-dir" && printf 'other machine\n' >"$d/stale-dir/x"

        backup_file "$d/absent-source" "$d/stale-file" >/dev/null
        backup_dir "$d/absent-source-dir" "$d/stale-dir" >/dev/null

        [ -f "$d/stale-file" ] || {
            fail "unit: backup_file deleted a destination whose source is absent"
            bad=1
        }
        [ -f "$d/stale-dir/x" ] || {
            fail "unit: backup_dir deleted a destination whose source is absent"
            bad=1
        }

        # And the copy path still works.
        printf 'live\n' >"$d/live-source"
        backup_file "$d/live-source" "$d/copied" >/dev/null
        unit_expect "backup_file copies" live "$(cat "$d/copied" 2>/dev/null)" || bad=1

        rm -f "$d"/stale-file "$d"/stale-dir/x "$d"/live-source "$d"/copied
        rmdir "$d/stale-dir" "$d"
        [ "$bad" -eq 0 ] && ok "backup_file and backup_dir never delete a stale destination"
        exit "$bad"
    )
}

unit_prune() {
    unit_require bin/lib/sync.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/common.sh
        . bin/lib/common.sh
        dotfiles_flags_init

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-prune.XXXXXX") || exit 1
        mkdir -p "$d/root"
        printf 'x\n' >"$d/root/keep-me"
        printf 'x\n' >"$d/root/drop-me"
        printf 'keep-me\n' >"$d/keeplist"

        # It prints the unwanted entry...
        unit_expect "names the entry absent from the keep-list" "$d/root/drop-me" \
            "$(sync_prune_extra "$d/root" "$d/keeplist")" || bad=1
        # ...and deletes nothing while doing so.
        [ -f "$d/root/drop-me" ] || {
            fail "unit: sync_prune_extra deleted something"
            bad=1
        }
        [ -f "$d/root/keep-me" ] || {
            fail "unit: sync_prune_extra removed a kept entry"
            bad=1
        }

        # A missing root is not an error.
        unit_expect "absent root prints nothing" "" \
            "$(sync_prune_extra "$d/nope" "$d/keeplist")" || bad=1

        # sync_prune_apply is inert under --dry-run.
        DOTFILES_DRY_RUN=1 sync_prune_apply "$d/root/drop-me" >/dev/null
        [ -f "$d/root/drop-me" ] || {
            fail "unit: sync_prune_apply deleted under --dry-run"
            bad=1
        }

        rm -f "$d"/root/keep-me "$d"/root/drop-me "$d"/keeplist
        rmdir "$d/root" "$d"
        [ "$bad" -eq 0 ] && ok "sync_prune_extra only reports; sync_prune_apply honours --dry-run"
        exit "$bad"
    )
}

# setup.sh dispatches by name — `run_step "$step" "step_$step"` — so a typo in
# ALL_STEPS is not a syntax error. It is a step that fails at runtime with
# "command not found", on a fresh machine, halfway through a bootstrap. And a
# step_* function missing from ALL_STEPS is simply dead: it never runs and
# nothing says so. Both directions are checked here, plus that NEVER_RESUME
# names real steps.
unit_steps() {
    unit_require setup.sh || return 1
    (
        bad=0
        steps=$(sed -n 's/^ALL_STEPS="\(.*\)"$/\1/p' "$REPO_ROOT/setup.sh")
        never=$(sed -n 's/^NEVER_RESUME="\(.*\)"$/\1/p' "$REPO_ROOT/setup.sh")

        if [ -z "$steps" ]; then
            fail "unit: cannot find ALL_STEPS in setup.sh"
            exit 1
        fi

        for s in $steps; do
            grep -q "^step_${s}() {" "$REPO_ROOT/setup.sh" || {
                fail "unit: ALL_STEPS names '$s', but setup.sh defines no step_$s"
                bad=1
            }
        done

        while IFS= read -r f; do
            [ -n "$f" ] || continue
            case " $steps " in
                *" $f "*) ;;
                *)
                    fail "unit: setup.sh defines step_$f, but ALL_STEPS omits it"
                    bad=1
                    ;;
            esac
        done < <(sed -n 's/^step_\([a-z_][a-z_]*\)() {$/\1/p' "$REPO_ROOT/setup.sh")

        for s in $never; do
            case " $steps " in
                *" $s "*) ;;
                *)
                    fail "unit: NEVER_RESUME names '$s', which is not a step"
                    bad=1
                    ;;
            esac
        done

        [ "$bad" -eq 0 ] && ok "setup.sh's ALL_STEPS and its step_* functions agree ($(printf '%s' "$steps" | wc -w | tr -d ' ') steps)"
        exit "$bad"
    )
}

# Duplicated PATH entries are invisible in normal use — everything still
# resolves, just from an unpredictable copy — which is how fifteen of them
# accumulated in a nested fish shell without anyone noticing. Nothing caught it,
# so this is the gate.
#
# Two properties, one about the data and one about the behaviour:
#
#   1. shell/path.spec lists no directory twice. A duplicate there is a defect
#      in the data, the same way a duplicated packages/ entry is.
#   2. Sourcing the generated POSIX file twice is a no-op, and the PATH it
#      produces has no duplicates. This is the property `set -x PATH $PATH ...`
#      got wrong. It is checked by actually running the generated file rather
#      than by inspecting it, because the emitted text is what ships.
#
# Portable by construction: with a $HOME that contains none of the spec's
# directories — every CI runner — the existence filter drops them all and the
# test still exercises dedupe and idempotence against the inherited PATH.
unit_pathspec() {
    unit_require shell/path.spec || return 1
    unit_require generated/session-variables.sh || return 1
    (
        bad=0

        dupes=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$REPO_ROOT/shell/path.spec" |
            grep -v '^#' | grep -v '^$' | sed 's/^@[^ ]* //' | sort | uniq -d | tr '\n' ' ')
        if [ -n "$dupes" ]; then
            fail "unit: shell/path.spec lists duplicates: ${dupes% }"
            bad=1
        fi

        # Single-quoted on purpose: $1 and $PATH belong to the child bash, and
        # expanding them here would compare this shell's PATH against itself.
        # shellcheck disable=SC2016
        out=$(env -i HOME="$HOME" PATH=/usr/bin:/bin /bin/bash --noprofile --norc -c '
            . "$1" >/dev/null 2>&1
            once=$PATH
            unset SESSION_VARS_SOURCED
            . "$1" >/dev/null 2>&1
            printf "%s\n%s\n" "$once" "$PATH"
        ' _ "$REPO_ROOT/generated/session-variables.sh" 2>/dev/null)

        once=$(printf '%s\n' "$out" | sed -n 1p)
        twice=$(printf '%s\n' "$out" | sed -n 2p)

        if [ -z "$once" ]; then
            fail "unit: sourcing generated/session-variables.sh produced no PATH"
            exit 1
        fi

        unit_expect "sourcing the generated PATH twice is a no-op" "$once" "$twice" || bad=1

        pdupes=$(printf '%s' "$once" | tr ':' '\n' | grep . | sort | uniq -d | tr '\n' ' ')
        if [ -n "$pdupes" ]; then
            fail "unit: generated PATH contains duplicates: ${pdupes% }"
            bad=1
        fi

        [ "$bad" -eq 0 ] && ok "path.spec has no duplicates; the generated PATH is deduped and idempotent"
        exit "$bad"
    )
}

# The packages/ files replace lists that were inline in setup.sh while bin/update
# needed the same ones, so a parser that silently returns nothing would put the
# drift straight back — a run that installs no gh extensions and reports success.
# Both the parse and the real files are checked: a file that parses to nothing,
# or that lists the same entry twice, is a defect in the data rather than a
# preference.
unit_packages() {
    unit_require bin/lib/util.sh || return 1
    (
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/util.sh
        . bin/lib/util.sh

        bad=0
        d=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-lint-packages.XXXXXX") || exit 1

        printf '# leading comment\n\nowner/one\n   owner/two   \nowner/three # trailing\n\n\n' >"$d/list"
        unit_expect "comments, blank lines and surrounding space are stripped" \
            "owner/one owner/two owner/three" \
            "$(package_list "$d/list" | tr '\n' ' ' | sed 's/ $//')" || bad=1

        : >"$d/empty"
        unit_expect "an empty file parses to nothing" "" \
            "$(package_list "$d/empty")" || bad=1

        printf '# only comments\n\n' >"$d/comments"
        unit_expect "a comment-only file parses to nothing" "" \
            "$(package_list "$d/comments")" || bad=1

        # A missing file must be distinguishable from an empty one, or a caller
        # cannot tell "nothing to install" from "the list is gone".
        if package_list "$d/nope" >/dev/null 2>&1; then
            fail "unit: package_list succeeded on a missing file"
            bad=1
        fi

        rm -f "$d"/list "$d"/empty "$d"/comments
        rmdir "$d"

        # And the real files, which is where a typo actually costs something.
        for f in "$REPO_ROOT"/packages/*; do
            [ -f "$f" ] || continue
            n=$(package_list "$f" | grep -c .)
            if [ "$n" -eq 0 ]; then
                fail "unit: ${f##*/} parses to no entries"
                bad=1
            fi
            dupes=$(package_list "$f" | sort | uniq -d | tr '\n' ' ')
            if [ -n "$dupes" ]; then
                fail "unit: ${f##*/} lists duplicates: ${dupes% }"
                bad=1
            fi
        done

        [ "$bad" -eq 0 ] && ok "package_list strips comments and space, fails on a missing file; packages/ has no empty or duplicated list"
        exit "$bad"
    )
}

# bin/update's keep-alive captured no PID and had no trap, so every interrupted
# run leaked a refresher until the loop next woke up — and setup.sh primed the
# password before it had parsed --dry-run. Both properties are checked here, and
# both are reachable without a password: privilege_refresh is redefined to
# `true`, so the whole lifecycle runs with no escalation at all. That seam is
# the reason it is a function rather than an inline command.
#
# privilege_prime is only ever called in dry-run mode below. Nothing here calls
# the real thing.
unit_privilege() {
    unit_require bin/lib/privilege.sh || return 1
    (
        # shellcheck source=bin/lib/log.sh
        . bin/lib/log.sh
        # shellcheck source=bin/lib/privilege.sh
        . bin/lib/privilege.sh

        privilege_refresh() { true; }
        _DL_PRIVILEGE_INTERVAL=1

        bad=0

        # Initialised at source time rather than on first use: this file is
        # sourced by setup.sh, which runs under `set -u`, and a bare `unset`
        # would make teardown fatal. '' means set-and-empty, UNSET means unset.
        unit_expect "PID is initialised at source time" "" \
            "${_DL_PRIVILEGE_PID-UNSET}" || bad=1

        # Release when nothing is running: exactly the case a trap hits after an
        # early exit, and the case bin/update could not handle.
        privilege_release || {
            fail "unit: privilege_release failed when no refresher was running"
            bad=1
        }

        # --dry-run must neither prompt nor start anything.
        DOTFILES_DRY_RUN=1 privilege_prime >/dev/null || bad=1
        DOTFILES_DRY_RUN=1 privilege_keepalive
        unit_expect "keepalive is inert under --dry-run" "" "$_DL_PRIVILEGE_PID" || bad=1

        privilege_keepalive
        pid=$_DL_PRIVILEGE_PID
        if [ -z "$pid" ]; then
            fail "unit: privilege_keepalive captured no PID"
            bad=1
        else
            kill -0 "$pid" 2>/dev/null || {
                fail "unit: privilege_keepalive started no refresher"
                bad=1
            }

            # Starting twice must not leave a second loop behind.
            privilege_keepalive
            unit_expect "keepalive is idempotent" "$pid" "$_DL_PRIVILEGE_PID" || bad=1

            privilege_release
            unit_expect "release clears the PID" "" "$_DL_PRIVILEGE_PID" || bad=1

            # Reap it here rather than in privilege_release: a trap that can
            # block is worse than one that leaves a reapable child behind.
            wait "$pid" 2>/dev/null
            if kill -0 "$pid" 2>/dev/null; then
                fail "unit: privilege_release left the refresher running"
                bad=1
            fi

            # Twice, because teardown can run from both a trap and a normal path.
            privilege_release || {
                fail "unit: a second privilege_release failed"
                bad=1
            }
        fi

        [ "$bad" -eq 0 ] && ok "privilege_keepalive captures its PID; release is safe idle, twice and under --dry-run"
        exit "$bad"
    )
}

# Each unit_* function prints its own ok/fail lines and returns 0 or 1, so one
# failing property does not hide the others.
check_unit() {
    heading "unit tests (bin/lib)"
    local bad=0
    unit_source_directives || bad=1
    unit_shells || bad=1
    unit_brew_prefix || bad=1
    unit_host_id || bad=1
    unit_brewfile_hosts || bad=1
    unit_brew_no_force || bad=1
    unit_brew_analysers || bad=1
    unit_profile || bad=1
    unit_conflicts || bad=1
    unit_no_prune || bad=1
    unit_prune || bad=1
    unit_packages || bad=1
    unit_pathspec || bad=1
    unit_steps || bad=1
    unit_privilege || bad=1
    unit_log_plain || bad=1
    [ "$bad" -eq 0 ] || FAILED[${#FAILED[@]}]=unit
}

# --- preferences manifest ---------------------------------------------------
#
# bin/lib/preferences.manifest is the table bin/preferences-{backup,restore}
# drive from, so its shape is load-bearing in a way a comment cannot enforce.
# Five properties, all checkable with no privileges and nothing installed.
#
# Property 5 needs the private submodule, which CI does not have, so it warns
# and skips there rather than failing — the same contract check_yaml uses.

check_manifest() {
    heading "preferences manifest"

    if [ ! -f bin/lib/preferences.sh ] || [ ! -f bin/lib/preferences.manifest ]; then
        fail "manifest: bin/lib/preferences.{sh,manifest} is missing"
        FAILED[${#FAILED[@]}]=manifest
        return
    fi

    # A real subshell writing to a temp file, not `out=$(...)`. bash 3.2 cannot
    # parse a `case` statement inside a command substitution — the closing paren
    # of a case pattern ends the substitution early — and this script is
    # deliberately bash 3.2. Verified: /bin/bash rejects the $() form outright
    # while bash 5 accepts it, which is exactly the trap the header warns about.
    local tmp rc rows
    tmp=$(mktemp "${TMPDIR:-/tmp}/dotfiles-lint-manifest.XXXXXX") || {
        fail "manifest: could not create a temp file"
        FAILED[${#FAILED[@]}]=manifest
        return
    }

    (
        set -uo pipefail
        _DL_ROOT=$REPO_ROOT
        # shellcheck source=bin/lib/common.sh
        . bin/lib/common.sh

        bad=0
        manifest=bin/lib/preferences.manifest
        prefs=private/preferences

        # 1. It parses, and prefs_load applies every per-row validation.
        prefs_load "$manifest" || exit 1

        seen_backup=""
        seen_live=""
        n_defaults=0
        n_plist=0
        n_support=0

        i=0
        while [ "$i" -lt ${#PREFS_ROWS[@]} ]; do
            prefs_split "${PREFS_ROWS[$i]}"
            i=$((i + 1))

            # 2. No duplicate backup path, no duplicate (kind, live) pair.
            case " $seen_backup " in
                *" $PREFS_BACKUP "*)
                    printf 'duplicate backup path: %s\n' "$PREFS_BACKUP"
                    bad=1
                    ;;
            esac
            seen_backup="$seen_backup $PREFS_BACKUP"

            case " $seen_live " in
                *" $PREFS_KIND:$PREFS_LIVE "*)
                    printf 'duplicate (kind, live): %s %s\n' "$PREFS_KIND" "$PREFS_LIVE"
                    bad=1
                    ;;
            esac
            seen_live="$seen_live $PREFS_KIND:$PREFS_LIVE"

            # 3. Inverse property: the slash pattern is fixed by the kind, which
            #    is what a1c332c and the cp -R nesting hazard become as an
            #    assertion. A support_dir is restored into the *parent* of live,
            #    so live must have one.
            # 4. Order: every row lands in exactly one restore pass.
            case "$PREFS_KIND" in
                defaults)
                    n_defaults=$((n_defaults + 1))
                    ;;
                plist)
                    n_plist=$((n_plist + 1))
                    if [ "${PREFS_LIVE%/*}" = "$PREFS_LIVE" ]; then
                        printf 'plist live needs a parent directory: %s\n' "$PREFS_LIVE"
                        bad=1
                    fi
                    ;;
                support_dir)
                    n_support=$((n_support + 1))
                    if [ "${PREFS_LIVE%/*}" = "$PREFS_LIVE" ]; then
                        printf 'support_dir live has no parent directory: %s\n' "$PREFS_LIVE"
                        bad=1
                    fi
                    ;;
                support_contents)
                    n_support=$((n_support + 1))
                    ;;
            esac
        done

        if [ "$((n_defaults + n_plist + n_support))" -ne "${#PREFS_ROWS[@]}" ]; then
            printf 'the three restore passes do not partition the rows\n'
            bad=1
        fi

        # 5. Coverage: everything at the top level of private/preferences/ is
        #    either a backup field or listed under "manual:".
        if [ -d "$prefs" ]; then
            manual=$(sed -n 's/^# manual|\([^|]*\)|.*/\1/p' "$manifest")
            for entry in "$prefs"/*; do
                [ -e "$entry" ] || continue
                name=${entry##*/}
                case " $seen_backup " in
                    *" $name "*) continue ;;
                esac
                printf '%s\n' "$manual" | grep -qxF -- "$name" && continue
                printf 'untracked in private/preferences/: %s\n' "$name"
                bad=1
            done
        else
            printf 'SKIP\n'
        fi

        printf 'ROWS %s\n' "${#PREFS_ROWS[@]}"
        exit "$bad"
    ) >"$tmp" 2>&1
    rc=$?

    rows=$(sed -n 's/^ROWS //p' "$tmp")
    if grep -q '^SKIP$' "$tmp"; then
        warn "manifest: private/preferences not present, coverage not checked"
        SKIPPED[${#SKIPPED[@]}]=manifest
    fi
    grep -v '^ROWS \|^SKIP$' "$tmp" | while IFS= read -r line; do
        [ -n "$line" ] && fail "manifest: $line"
    done
    rm -f "$tmp"

    if [ "$rc" -ne 0 ]; then
        FAILED[${#FAILED[@]}]=manifest
        return
    fi
    ok "${rows:-0} entries parse, are unique, and cover private/preferences/"
}

# --- config owners ----------------------------------------------------------
#
# bin/lib/config-owners.manifest says what installs the tool behind each entry
# in config/. This asserts the two directions that make it worth trusting: every
# entry has a row, and every row has an entry.
#
# The first is the forcing function. install.conf.yaml globs config/* into
# ~/.config/, so a directory added here is live configuration whether or not
# anything installs the tool it configures — which is how four entries ended up
# with no installer at all. Failing the build until somebody says what provides
# a new one is the only way that stays true.
#
# The second catches the reverse: a config directory deleted while its row
# stayed, leaving the manifest describing a tool this repository no longer
# configures.

OWNER_KINDS="brew mise gh-ext fisher setup mason manual orphan"

check_owners() {
    heading "config/ owners"
    local manifest=bin/lib/config-owners.manifest
    local rc=0 rows=0 entry kind fields dupes line

    if [ ! -f "$manifest" ]; then
        fail "owners: $manifest is missing"
        FAILED[${#FAILED[@]}]=owners
        return
    fi

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        rows=$((rows + 1))
        fields=$(printf '%s\n' "$line" | awk -F'|' '{print NF}')
        if [ "$fields" -ne 4 ]; then
            fail "owners: not 4 fields ($fields): $line"
            rc=1
            continue
        fi
        entry=${line%%|*}
        kind=$(printf '%s\n' "$line" | cut -d'|' -f2)
        case " $OWNER_KINDS " in
            *" $kind "*) ;;
            *)
                fail "owners: unknown kind '$kind' for $entry (want: $OWNER_KINDS)"
                rc=1
                ;;
        esac
        if [ ! -e "config/$entry" ]; then
            fail "owners: config/$entry is listed but does not exist"
            rc=1
        fi
    done <<EOF
$(strip_comments "$manifest" | grep .)
EOF

    if [ "$rows" -eq 0 ]; then
        fail "owners: $manifest parses to no rows"
        rc=1
    fi

    dupes=$(strip_comments "$manifest" | grep . | cut -d'|' -f1 | sort | uniq -d | tr '\n' ' ')
    if [ -n "$dupes" ]; then
        fail "owners: listed more than once: ${dupes% }"
        rc=1
    fi

    # And the direction that actually forces the decision.
    for entry in config/*; do
        [ -e "$entry" ] || continue
        entry=${entry##*/}
        # .DS_Store is Finder's, not configuration, and is gitignored.
        [ "$entry" = .DS_Store ] && continue
        if ! strip_comments "$manifest" | grep . | cut -d'|' -f1 | grep -qxF -- "$entry"; then
            fail "owners: config/$entry has no row in $manifest"
            fail "        add one saying what installs it — 'orphan' is a valid answer"
            rc=1
        fi
    done

    if [ "$rc" -ne 0 ]; then
        FAILED[${#FAILED[@]}]=owners
        return
    fi
    ok "$rows entries parse, are unique, and cover config/"
}

# --- generated-file drift ---------------------------------------------------
#
# Re-run the generator and assert the tree did not move. This is the only check
# in the suite that *writes*, which is deliberate: a dry run cannot prove the
# committed output matches the spec, only regenerating can.
#
# The gate is `-x`, not `-f`. A generator committed without its exec bit would
# make this skip silently, which is the failure mode a drift gate exists to
# prevent.

GENERATOR="bin/generate-shell-config"

# What the generator writes, and therefore the only paths this check may judge.
# Scoped rather than whole-repo: an unrelated unstaged edit elsewhere must not
# be reported as generated-file drift. Update alongside the generator's own
# output list.
DRIFT_PATHS="generated config/nushell/env.nu config/fish/conf.d"

check_drift() {
    heading "generated-file drift"
    if [ ! -x "$GENERATOR" ]; then
        warn "no $GENERATOR yet (arrives with SI-84)"
        SKIPPED[${#SKIPPED[@]}]=drift
        return
    fi

    if ! "$GENERATOR" >/dev/null; then
        fail "$GENERATOR exited non-zero"
        FAILED[${#FAILED[@]}]=drift
        return
    fi

    local changed untracked
    # shellcheck disable=SC2086  # DRIFT_PATHS is a deliberate pathspec list
    changed=$(git -C "$REPO_ROOT" diff --name-only -- $DRIFT_PATHS)
    # `git diff` is blind to untracked files, so a brand-new generated file
    # would otherwise sail through green on the machine that forgot to add it.
    # shellcheck disable=SC2086  # as above
    untracked=$(git -C "$REPO_ROOT" ls-files --others --exclude-standard -- $DRIFT_PATHS)

    if [ -z "$changed" ] && [ -z "$untracked" ]; then
        ok "generated files are up to date"
        return
    fi

    [ -z "$changed" ] || fail "stale: $(printf '%s' "$changed" | tr '\n' ' ')"
    [ -z "$untracked" ] || fail "untracked: $(printf '%s' "$untracked" | tr '\n' ' ')"
    fail "run: $GENERATOR && git add -A"
    FAILED[${#FAILED[@]}]=drift
}

# --- main -------------------------------------------------------------------

if [ "$LIST_ONLY" -eq 1 ]; then
    select_files shell_sources
    exit 0
fi

[ "$STAGED" -eq 1 ] && printf 'Linting staged files only.\n'

for check in "${CHECKS[@]}"; do
    "check_$check"
done

printf '\n'
[ ${#SKIPPED[@]} -gt 0 ] && warn "skipped: ${SKIPPED[*]}"
if [ ${#FAILED[@]} -gt 0 ]; then
    fail "failed: ${FAILED[*]}"
    exit 1
fi
printf '%sAll checks passed.%s\n' "$C_GREEN" "$C_OFF"
