#!/bin/bash
#
# claude-backup
# Backs up Claude Code configuration to private/ submodule
# Each profile (work or personal) is fully isolated — no shared/ directory.
#
# Usage: claude-backup
# Reads ~/.agentic-profile, falling back to legacy ~/.machine-profile.
# Set with: agentic-set-profile work|personal

set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

dotfiles_flags_init

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DOTFILES_DRY_RUN=1 ;;
        -y | --yes) DOTFILES_ASSUME_YES=1 ;;
        --allow-dirty) DOTFILES_ALLOW_DIRTY=1 ;;
        -h | --help)
            log_info "Usage: claude-backup [--dry-run] [--yes] [--allow-dirty]"
            exit 0
            ;;
        *)
            log_err "claude-backup: unknown argument: $1"
            exit 1
            ;;
    esac
    shift
done

CLAUDE_DIR="$HOME/.claude"
DOTFILES=$(dotfiles_root)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

PROFILE=$(agentic_profile) || exit 1
PROFILE_DIR="$DOTFILES/private/claude/$PROFILE"
LEGACY_SHARED="$DOTFILES/private/claude/shared"

log_done "Starting Claude Code backup..."
log_field "Profile" "$PROFILE"

# Remove legacy shared/ if present.
#
# This used to be a bare `read -p`, which under `set -e` returns non-zero when
# stdin is not a terminal — so on any machine that still had a legacy shared/
# directory, claude-backup aborted here and took no backup at all. bin/update
# calls it without a terminal and has no `set -e` of its own, so it carried on
# to the next step and still exited 0: the backup silently stopped happening and
# nothing said so. No machine here has shared/ any more, which is why it was
# never noticed.
#
# confirm() answers "no" without a terminal rather than failing, so the
# unattended case now skips the deletion — the safe answer for an rm -rf — and
# the backup proceeds. --yes opts in.
if [ -d "$LEGACY_SHARED" ]; then
    log_warn "Legacy shared/ directory found: $LEGACY_SHARED"
    if [ "$DOTFILES_ASSUME_YES" -eq 1 ] ||
        confirm "Delete it? All content moves to per-profile dirs from now on."; then
        run rm -rf "$LEGACY_SHARED"
        [ "$DOTFILES_DRY_RUN" -eq 1 ] || log_ok "Deleted: $LEGACY_SHARED"
    else
        log_warn "  Skipped deletion — shared/ still exists."
    fi
fi

run mkdir -p "$PROFILE_DIR"

# ── Settings & identity ───────────────────────────────────────────────────────

log_step "Backing up settings..."
backup_file "$CLAUDE_DIR/CLAUDE.md" "$PROFILE_DIR/CLAUDE.md"
backup_file "$CLAUDE_DIR/RTK.md" "$PROFILE_DIR/RTK.md"
backup_file "$CLAUDE_DIR/settings.json" "$PROFILE_DIR/settings.json"
backup_file "$CLAUDE_DIR/keybindings.json" "$PROFILE_DIR/keybindings.json"
backup_file "$CLAUDE_DIR/mcp-needs-auth-cache.json" "$PROFILE_DIR/mcp-needs-auth-cache.json"
backup_file "$CLAUDE_DIR/policy-limits.json" "$PROFILE_DIR/policy-limits.json"

# ── Commands, scripts, hooks, skills ─────────────────────────────────────────

log_step "Backing up commands, scripts, hooks & skills..."
backup_dir "$CLAUDE_DIR/commands" "$PROFILE_DIR/commands"
backup_dir "$CLAUDE_DIR/scripts" "$PROFILE_DIR/scripts"
backup_dir "$CLAUDE_DIR/hooks" "$PROFILE_DIR/hooks"
backup_dir "$CLAUDE_DIR/skills" "$PROFILE_DIR/skills"

# ── Plugins ───────────────────────────────────────────────────────────────────

log_step "Backing up plugins configuration..."
backup_file "$CLAUDE_DIR/plugins/known_marketplaces.json" "$PROFILE_DIR/plugins/known_marketplaces.json"

# ── Profile-specific state ────────────────────────────────────────────────────

log_step "Backing up profile state..."
backup_file "$HOME/.claude.json" "$PROFILE_DIR/.claude.json"
backup_file "$CLAUDE_DIR/history.jsonl" "$PROFILE_DIR/history.jsonl"
backup_file "$CLAUDE_DIR/stats-cache.json" "$PROFILE_DIR/stats-cache.json"

# ── Projects ─────────────────────────────────────────────────────────────────

log_step "Backing up project configurations..."
if [ -d "$CLAUDE_DIR/projects" ]; then
    for project_dir in "$CLAUDE_DIR/projects"/*; do
        if [ -d "$project_dir" ]; then
            project_name=$(basename "$project_dir")

            if [ -f "$project_dir/.claude.json" ]; then
                backup_file "$project_dir/.claude.json" "$PROFILE_DIR/projects/$project_name/.claude.json"
            fi

            if [ -f "$project_dir/CLAUDE.md" ]; then
                backup_file "$project_dir/CLAUDE.md" "$PROFILE_DIR/projects/$project_name/CLAUDE.md"
            fi

            if [ -d "$project_dir/memory" ] && [ "$(ls -A "$project_dir/memory" 2>/dev/null)" ]; then
                backup_dir "$project_dir/memory" "$PROFILE_DIR/projects/$project_name/memory"
            fi

            if [ -f "$project_dir/hooks.json" ]; then
                backup_file "$project_dir/hooks.json" "$PROFILE_DIR/projects/$project_name/hooks.json"
            fi
        fi
    done
fi

# ── Plans ─────────────────────────────────────────────────────────────────────

log_step "Backing up plans..."
backup_dir "$CLAUDE_DIR/plans" "$PROFILE_DIR/plans"

# ── Shell snapshots (latest 5) ────────────────────────────────────────────────

log_step "Backing up shell snapshots..."
if [ -d "$CLAUDE_DIR/shell-snapshots" ] && [ "$(ls -A "$CLAUDE_DIR/shell-snapshots" 2>/dev/null)" ]; then
    run mkdir -p "$PROFILE_DIR/shell-snapshots"
    # `find -exec stat` rather than `ls -t`: parsing ls output is SC2012, and
    # the pre-commit hook requires a staged file to be clean rather than merely
    # at the baseline. Sorting stat's mtime descending is the same "newest
    # first" ls -t gave, and -type f drops anything that is not a snapshot.
    find "$CLAUDE_DIR/shell-snapshots" -maxdepth 1 -type f -exec stat -f '%m %N' {} + |
        sort -rn | head -5 | cut -d' ' -f2- |
        while IFS= read -r snapshot; do
            run cp "$snapshot" "$PROFILE_DIR/shell-snapshots/"
        done
    log_ok "Backed up: shell-snapshots/ (latest 5 snapshots)"
else
    log_skip "Not found or empty: shell-snapshots/"
fi

# ── Manifest ─────────────────────────────────────────────────────────────────

log_step "Creating backup manifest..."
write_file "$PROFILE_DIR/BACKUP_INFO.txt" <<EOF
Claude Code Backup
==================
Timestamp:  $TIMESTAMP
Hostname:   $(host_id)
Profile:    $PROFILE
Claude Dir: $CLAUDE_DIR

Backed up:
- CLAUDE.md, RTK.md, settings.json, keybindings.json
- mcp-needs-auth-cache.json, policy-limits.json
- commands/, scripts/, hooks/, skills/
- plugins/known_marketplaces.json
- .claude.json (auth)
- history.jsonl, stats-cache.json
- Project configs (.claude.json, CLAUDE.md, memory/, hooks.json)
- plans/
- Recent shell snapshots (last 5)

Excluded (large / transient):
- projects/**/*.jsonl (conversation history)
- cache/, telemetry/, file-history/, session-env/, sessions/, backups/
- settings.json.bak, .caveman-active, .last-cleanup
EOF

log_done "Backup complete!"
log_info "  Profile dir: $PROFILE_DIR"
log_info ""
log_info "To restore on another machine, run: claude-restore"
