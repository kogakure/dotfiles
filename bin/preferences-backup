#!/bin/bash
#
# Export application preferences into private/preferences/.
#
# Usage: preferences-backup [--dry-run] [--allow-dirty]
#
# The table lives in bin/lib/preferences.manifest; this walks it top to bottom.
# Adding an app is one line there and nothing here.
#
# `set -uo pipefail`, deliberately without -e, matching bin/preferences-restore.
# One app that was never installed must not stop the other eighteen — and this
# script runs late in bin/update, so aborting here used to mean the remaining
# steps silently stopped happening. Every entry is guarded individually instead.

set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

dotfiles_flags_init

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DOTFILES_DRY_RUN=1 ;;
        --allow-dirty) DOTFILES_ALLOW_DIRTY=1 ;;
        -h | --help)
            log_info "Usage: preferences-backup [--dry-run] [--allow-dirty]"
            exit 0
            ;;
        *)
            log_err "preferences-backup: unknown argument: $1"
            exit 1
            ;;
    esac
    shift
done

PREFS=$(prefs_dir)

if [ ! -d "$PREFS" ]; then
    log_err "preferences-backup: ${PREFS} not found — is the private submodule initialised?"
    exit 1
fi

private_gate preferences || exit 1

prefs_load "$(prefs_manifest)" || exit 1

log_step "Backing up ${#PREFS_ROWS[@]} preference entries..."

i=0
failed=0
while [ "$i" -lt ${#PREFS_ROWS[@]} ]; do
    prefs_split "${PREFS_ROWS[$i]}"
    i=$((i + 1))
    prefs_backup "$PREFS" || failed=$((failed + 1))
done

if [ "$failed" -gt 0 ]; then
    log_err "preferences-backup: ${failed} entr(y|ies) failed."
    exit 1
fi

if [ "$DOTFILES_DRY_RUN" -eq 1 ]; then
    log_warn "dry run: nothing was changed"
else
    log_done "Preferences written to ${PREFS}"
fi
