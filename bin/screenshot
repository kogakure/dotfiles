#!/bin/bash
#
# Create a set of screenshots from a URL
# Usage: screenshot <url> [pageres options...]

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: screenshot <url> (parameters)" >&2
    exit 127
fi

# "$@" rather than $*: unquoted $* collapses the arguments into one
# whitespace-split string, so a URL containing a space or a shell glob was
# mangled before pageres ever saw it.
pageres 375x667 768x1024 1280x800 "$@"
