#!/bin/bash
#
# codex-restore
# Restores durable Codex configuration from the private/ submodule.
#
# Usage: codex-restore [source-profile]
# Reads ~/.agentic-profile, falling back to legacy ~/.machine-profile.
# Set with: agentic-set-profile work|personal

set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh" || exit 1

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
DOTFILES=$(dotfiles_root)

PROFILE=$(agentic_profile) || exit 1
SOURCE_PROFILE="${1:-$PROFILE}"

assert_valid_profile "$SOURCE_PROFILE" "source profile" || exit 1

PROFILE_DIR="$DOTFILES/private/codex/$SOURCE_PROFILE"

log_done "Starting Codex configuration restore..."
log_field "Machine profile" "$PROFILE"
log_field "Backup source" "$SOURCE_PROFILE"
log_field "Codex home" "$CODEX_DIR"

if [ ! -d "$PROFILE_DIR" ]; then
    log_err "Error: No backup found at $PROFILE_DIR"
    log_info "Run codex-backup first or ensure the private/ submodule is initialized."
    exit 1
fi

if [ -f "$PROFILE_DIR/BACKUP_INFO.txt" ]; then
    log_warn ""
    log_warn "Backup Information:"
    cat "$PROFILE_DIR/BACKUP_INFO.txt"
    log_info ""
fi

if ! confirm "Do you want to restore Codex settings from backup?"; then
    log_info "Restore cancelled."
    exit 0
fi

conflicts=$(sync_conflicts \
    "$PROFILE_DIR/config.toml" "$CODEX_DIR/config.toml" \
    "$PROFILE_DIR/AGENTS.md" "$CODEX_DIR/AGENTS.md" \
    "$PROFILE_DIR/AGENTS.override.md" "$CODEX_DIR/AGENTS.override.md" \
    "$PROFILE_DIR/hooks.json" "$CODEX_DIR/hooks.json")

if [ -n "$conflicts" ]; then
    log_warn "$(printf '%s\n' "$conflicts" | wc -l | tr -d ' ') existing file(s) will be overwritten. Examples:"
    printf '%s\n' "$conflicts" | head -5 | sed 's/^/  /'
    if ! confirm "Continue?"; then
        log_info "Restore cancelled."
        exit 0
    fi
fi

run mkdir -p "$CODEX_DIR"

log_step "Restoring settings and global instructions..."
restore_file "$PROFILE_DIR/config.toml" "$CODEX_DIR/config.toml"
restore_file "$PROFILE_DIR/AGENTS.md" "$CODEX_DIR/AGENTS.md"
restore_file "$PROFILE_DIR/AGENTS.override.md" "$CODEX_DIR/AGENTS.override.md"
restore_file "$PROFILE_DIR/hooks.json" "$CODEX_DIR/hooks.json"
restore_dir "$PROFILE_DIR/rules" "$CODEX_DIR/rules"

log_step "Restoring user-installed skills..."
restore_dir "$PROFILE_DIR/skills" "$CODEX_DIR/skills"

log_info ""
log_done "Restore complete!"
log_info "Sign in to Codex separately; credentials were intentionally not backed up."
log_info "Restart Codex to apply the restored configuration from: $SOURCE_PROFILE"
